// The {{.Name}} app's invariants: what its bindings judge, over grist's
// generated actions ({{.Name}}_steps.qnt, `go run ./cmd/{{.Name}} model`: an
// action per block with its outcome branches and frame conditions, step)
// and the app's rules ({{.Name}}_rules.qnt). Regenerating the skeleton never
// touches this file.

// The store's side ({{.Name}}.binding.yaml).
module {{.Q}} {
  import grist.* from "./grist"
  import {{.Q}}Events.* from "./{{.Name}}_gen"
  import {{.Q}}Rules.* from "./{{.Name}}_rules"
  import {{.Q}}Gen.* from "./{{.Name}}_steps"
  export {{.Q}}Gen.*

  // the design's: no item past its capacity, in any state
  // grist: invariant
  val withinCapacity = withinCapacityIn(log)

  // after a settle: the warehouse received every addition (its served
  // record, ok), or its every try failed and the log says so. Stronger
  // than the generated shelveEventuallyHandled (an ok effect step), one of
  // the obligations the catalog implies ({{.Name}}_steps.qnt, beside
  // tallyEventuallyHandled and warehouseReceiveEventuallyServed)
  // grist: eventually
  val everyAdditionShelved = log.indices().forall(i => log[i].typ == "item-added" implies and {
    checkpoints.get("shelve") >= i + 1,
    warehouseReceiveRecords.select(r => r.trigger == i + 1 and r.result == "ok").length() > 0 or holds(log, failed("shelve", i + 1)),
  })
}

// The clients' side ({{.Name}}.calls.binding.yaml), linearized.
module {{.Q}}Calls {
  import grist.* from "./grist"
  import {{.Q}}Events.* from "./{{.Name}}_gen"
  import {{.Q}}Rules.* from "./{{.Name}}_rules"
  import {{.Q}}CallsGen.* from "./{{.Name}}_steps"
  export {{.Q}}CallsGen.*

  // grist: invariant
  val withinCapacity = withinCapacityIn(log)
}
