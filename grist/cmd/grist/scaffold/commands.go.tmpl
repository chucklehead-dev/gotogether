package {{.Pkg}}

import "github.com/chucklehead-dev/gotogether/grist"

// AddItem adds Qty of Item.
type AddItem struct {
	Item string `json:"item"`
	Qty  int    `json:"qty"`
}

// ErrInvalid is the add-item command's refusal of a quantity that is not
// positive (its capacity's refusal is the Capacity rule's, rules.go).
var ErrInvalid = grist.Rejection("invalid")

// decideAdd refuses an invalid quantity before reading anything. The
// capacity is a rule on every addition (CapacityRule), checked after the
// decision on its reads.
func decideAdd(r *grist.Reads, c AddItem) ([]grist.Event, error) {
	if c.Qty <= 0 {
		return nil, ErrInvalid
	}
	return []grist.Event{Added.Of(ItemAdded{Item: c.Item, Qty: c.Qty})}, nil
}

// Add is the add-item command. It declares the events it appends
// (Appends), so the rules on them guard it.
var Add = grist.NewCommand(App, "add-item", decideAdd, grist.Appends(Added), grist.Refuses(ErrInvalid), grist.Authorize(grist.Authenticated))
