package {{.Pkg}}

import (
	"testing"

	"github.com/chucklehead-dev/gotogether/grist/gristsim"
	"github.com/chucklehead-dev/gotogether/grist/gristtest"
	"github.com/chucklehead-dev/gotogether/qenv"
	"github.com/chucklehead-dev/gotogether/qtest"
)

// The bindings, generated from the App's catalog (`go run ./cmd/{{.Name}}
// model`): the store's side and the clients'.
const (
	commits = "{{.Name}}.binding.yaml"
	calls   = "{{.Name}}.calls.binding.yaml"
)

// faulty crashes the node at 2 in 100 scheduling steps and loses the
// answer of 15 in 100 commits (with CommitFaults), every other fault at
// the default rate (requests and answers lost, duplicated and late).
var faulty = qenv.DefaultRates.Set("nemesis", 0.02).Set("store.{{.Name}}.commit", 0.15)

// system is the app under cfg, its runs judged by binding, at faulty
// rates (a gristsim.System: the mutant this binary was built with, if
// any, planted).
func system(binding string, cfg gristsim.Config) qtest.System {
	return gristsim.System(binding, App, cfg).WithRates(faulty)
}

// contended is one tenant, three clients of four operations each, the
// arguments drawn from their types: items a and b, quantities -1 to 3
// (gristsim's default Ints: none or fewer among them, refused).
var contended = gristsim.Config{Tenants: []string{"t1"}, Clients: 3, Ops: 4, CommitFaults: true, Alphabet: []string{"a", "b"}}

// TestFaithful: through commit faults, node crashes and a lossy API, every
// run conforms at the store and settles (every addition tallied), the
// commit faults happened, and the runs exercised every block of the
// catalog, each command by each of its outcomes (a run that reached none
// of the app's blocks would pass every other claim).
func TestFaithful(t *testing.T) {
	t.Parallel()
	qtest.RequireQuint(t)
	system(commits, contended).Explore(t, qtest.ExploreConfig{Seeds: 20, ShortSeeds: 3}).
		Expect(t, qtest.Conforms(), qtest.All(qtest.Settles()), qtest.Reaches("store.{{.Name}}.commit").Faulted(), gristtest.Catalog(App).Exercised())
}

// TestFaithfulAtClients: the same runs judged where the clients saw them,
// linearized: an addition applied twice would show as a stock no order
// explains.
func TestFaithfulAtClients(t *testing.T) {
	t.Parallel()
	qtest.RequireQuint(t)
	system(commits, contended).WithBinding(calls, qtest.Linearize()).Explore(t, qtest.ExploreConfig{Seeds: 20, ShortSeeds: 3}).
		Expect(t, qtest.Conforms())
}

// fill is two clients adding 1 to 3 to one item, no faults: the capacity
// is reached. The drop-capacity mutant's shape (the rule dropped).
var fill = gristsim.Config{Tenants: []string{"t1"}, Clients: 2, Ops: 4, Send: []string{"add-item"}, Alphabet: []string{"a"}, Ints: []int{1, 2, 3}}

// fillUp is an acceptance scenario, in the catalog's own values: an
// item filled, then an addition past its capacity refused by the
// capacity rule. Its arguments are in the model's domains (STRS, INTS in
// model/{{.Name}}_rules.qnt), so the model on its own can follow it.
var fillUp = gristtest.Scenario("fill up",
	Add.With(AddItem{Item: "a", Qty: 3}),
	Add.With(AddItem{Item: "a", Qty: 3}).Refused(ErrFull))

// TestScenariosPossible: the model on its own can follow each acceptance
// scenario, before any run is checked against it (a model whose rules
// never refused past the capacity would fail here).
func TestScenariosPossible(t *testing.T) {
	t.Parallel()
	qtest.Possible(t, commits, fillUp)
}

// TestFull: the faithful app at the mutant's shape refuses past the
// capacity (the capacity rule's refusal), some run following the fill-up
// scenario, and no run rejects an addition.
func TestFull(t *testing.T) {
	t.Parallel()
	qtest.RequireQuint(t)
	system(commits, fill).WithRates(qenv.NoFaults).Explore(t, qtest.ExploreConfig{Seeds: 10, ShortSeeds: 3}).
		Expect(t, qtest.Conforms(), qtest.None(qtest.Rejects("addItem")), qtest.Some(fillUp))
}

// TestGenerated: the model's skeleton and the bindings are what the
// catalog generates (regenerate with `go run ./cmd/{{.Name}} model`).
func TestGenerated(t *testing.T) {
	if qtest.Mutant() != "" {
		t.Skip("a mutant's binary: its catalog is not the app's")
	}
	gristtest.Generated(t, App)
}
