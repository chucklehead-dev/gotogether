package {{.Pkg}}

import (
	"testing"

	"github.com/chucklehead-dev/gotogether/grist/gristtest"
	"github.com/chucklehead-dev/gotogether/qenv"
	"github.com/chucklehead-dev/gotogether/qtest"
)

// TestMutant states what catches the mutant this binary was built with
// (testdata/mutants/<name>: files replacing the app's of the same name,
// the way to plant one by hand; drop-<rule>: the app with one of its
// rules dropped, generated, gristtest.RuleMutants); TestMutants builds
// and runs it once per mutant.
func TestMutant(t *testing.T) {
	mutant := qtest.Mutant()
	if mutant == "" {
		t.Skip("the app as it is: TestMutants runs this test built with each mutant's overlay")
	}
	qtest.RequireQuint(t)
	if _, caught, ok := gristtest.DroppedRule(App); ok {
		// a rule dropped (drop-capacity, generated): an addition past the
		// capacity commits where the model's guard (capacityRefusal) refuses
		// it. The rule still reads: the first addition must be accepted by
		// the model, then the second rejected for the guard's full outcome,
		// not an incidental missing read (TestFull is the contrast).
		x := system(commits, fill).WithRates(qenv.NoFaults).Explore(t, qtest.ExploreConfig{Seeds: 1})
		x.Expect(t, caught)
		for _, run := range x.Runs {
			if run.Report == nil {
				t.Fatal("capacity mutant produced no model report")
			}
			found := false
			for _, actor := range run.Report.Actors {
				f := actor.Failure
				if f == nil || f.Step == nil || f.Step.Action != "addItem" {
					continue
				}
				found = true
				if f.Index < 0 || f.Index > len(actor.Calls) {
					t.Fatalf("invalid failing call index %d", f.Index)
				}
				accepted := 0
				for _, call := range actor.Calls[:f.Index] {
					if call.Action == "addItem" {
						accepted++
					}
				}
				if accepted != 1 {
					t.Fatalf("capacity mutant rejected after %d accepted additions, want exactly one", accepted)
				}
			}
			if !found {
				t.Fatal("capacity mutant produced no rejected addition")
			}
		}
		return
	}
	switch mutant {
	case "noInvalid":
		// the quantity check left out: an addition of none or fewer commits
		// where the model's rule refuses it (TestFaithful is the contrast)
		system(commits, contended).WithRates(qenv.NoFaults).Explore(t, qtest.ExploreConfig{Seeds: 6, ShortSeeds: 3}).
			Expect(t, qtest.Some(qtest.Rejects("addItem")))
	default:
		t.Fatalf("mutant %s: say what catches it (a case of TestMutant)", mutant)
	}
}

// Each mutant, found in testdata/mutants and built with its overlay (or,
// a rule's, generated from the App's catalog), is caught as TestMutant
// says: a new directory there is a new mutant, which TestMutant must
// name.
func TestMutants(t *testing.T) {
	t.Parallel()
	qtest.Mutants{Generated: gristtest.RuleMutants(App)}.Run(t)
}
