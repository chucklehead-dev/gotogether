// Generated by grist model from the shop App's catalog (docs/grist.md §3.2):
// do not edit. Regenerate with the app's binary (`<app> model`, grist.Main)
// after changing a block; the application's rules are model/shop_rules.qnt's,
// its invariants model/shop.qnt's.

// The store's side (shop.binding.yaml): every step where it took effect, one
// tenant's log. Commits are relayed from the store's step log, refusals
// recorded at their commit, queries on return, effects by their processors,
// sites by the dependencies that make them.
module shopGen {
  import grist.* from "./grist"
  import shopEvents.* from "./shop_gen"
  import shopRules.* from "./shop_rules"
  export grist.*
  export shopEvents.*
  export shopRules.*

  // one tenant's log
  var log: List[Event]
  // each processor's checkpoint: the last trigger it handled
  var checkpoints: str -> int
  // the batch the last step appended (what its observations are checked against)
  var appended: List[Event]
  // the effect steps: (processor, trigger, key, ok)
  var effects: List[Effect]
  // the command ids answered so far, by a commit or a committed refusal
  var answered: Set[str]
  // the log went backwards (gristRewound) and no operator has resumed the
  // processors since (gristResumed): they take no step
  var rewound: bool
  // what the warehouse-picks site recorded, in order
  var warehousePicksRecords: List[WarehousePicksRecord]
  // the calls of warehouse/hold as their callers saw them (Call.Do), and as the dependency
  // applied them (its served records), in order
  var warehouseHoldCalls: List[WarehouseHoldRecord]
  var warehouseHoldRecords: List[WarehouseHoldRecord]
  // the calls of billing/bill, a peer's command, as their callers saw them (Call.Do), in
  // order; the peer's model judges what it did
  var billingBillCalls: List[BillingBillRecord]

  action init = all {
    log' = [],
    checkpoints' = Map("ship" -> 0, "notify" -> 0, "charge" -> 0, "invoice" -> 0),
    appended' = [],
    effects' = [],
    answered' = Set(),
    rewound' = false,
    warehousePicksRecords' = [],
    warehouseHoldCalls' = [],
    warehouseHoldRecords' = [],
    billingBillCalls' = [],
  }

  // the identities, in the order commands take them, and the effect keys the
  // model on its own draws
  pure val IDS = ["i1", "i2", "i3", "i4", "i5", "i6", "i7", "i8", "i9", "i10", "i11", "i12", "i13", "i14", "i15", "i16", "i17", "i18", "i19", "i20", "i21", "i22", "i23", "i24", "i25", "i26", "i27", "i28", "i29", "i30"]
  pure val KEYS = Set("k1", "k2", "k3")
  // the next identity a command answers (none once all are): the first
  // unanswered, so that the model on its own never draws a used one (a
  // command that would be disabled) nor two that differ only by name
  pure def nextID(answered: Set[str]): Set[str] =
    IDS.foldl(Set(), (s, i) => if (s == Set() and not(answered.contains(i))) Set(i) else s)

  // a command's commit of b, answering id
  action appends(b: List[Event], id: str): bool = all {
    log' = log.concat(b),
    checkpoints' = checkpoints,
    appended' = b,
    effects' = effects,
    answered' = answered.union(Set(id)),
    rewound' = rewound,
    warehousePicksRecords' = warehousePicksRecords,
    warehouseHoldCalls' = warehouseHoldCalls,
    warehouseHoldRecords' = warehouseHoldRecords,
    billingBillCalls' = billingBillCalls,
  }

  // a committed refusal: its marker answers id, nothing is appended; it
  // commits at the head, at or after the position it read through
  action refuses(readPos: int, id: str): bool = all {
    readPos <= log.length(),
    appends([], id),
  }

  // a step that commits nothing (a query, a reused key): it read through
  // readPos, the log's length where it is ordered (2·readPos+1)
  action readsThrough(readPos: int): bool = all {
    log.length() == readPos,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    rewound' = rewound,
    warehousePicksRecords' = warehousePicksRecords,
    warehouseHoldCalls' = warehouseHoldCalls,
    warehouseHoldRecords' = warehouseHoldRecords,
    billingBillCalls' = billingBillCalls,
  }

  // a processor's handling of trigger, appending b with its checkpoint
  action processes(b: List[Event], p: str, trigger: int): bool = all {
    not(rewound),
    log' = log.concat(b),
    checkpoints' = checkpoints.set(p, trigger),
    appended' = b,
    effects' = effects,
    answered' = answered,
    rewound' = rewound,
    warehousePicksRecords' = warehousePicksRecords,
    warehouseHoldCalls' = warehouseHoldCalls,
    warehouseHoldRecords' = warehouseHoldRecords,
    billingBillCalls' = billingBillCalls,
  }

  // an effect step of processor p for trigger, under key (the same on every
  // effect step of the trigger, no other trigger's: keyStable)
  action effectStep(p: str, trigger: int, key: str, ok: bool): bool = all {
    not(rewound),
    keyStable(effects, p, trigger, key),
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects.append((p, trigger, key, ok)),
    answered' = answered,
    rewound' = rewound,
    warehousePicksRecords' = warehousePicksRecords,
    warehouseHoldCalls' = warehouseHoldCalls,
    warehouseHoldRecords' = warehouseHoldRecords,
    billingBillCalls' = billingBillCalls,
  }

  // the log went backwards (grist.ErrRewound: a failover lost its tail, a
  // restore put a backup back), as a node's relay saw it: back to position
  // pos, each processor's checkpoint there cps, the ids answered after it lost. The
  // processors stop until an operator resumes them (gristResumed); what the
  // dependencies and the effects did stays done
  action gristRewound(pos: int, cps: str -> int, lost: Set[str]): bool = all {
    pos <= log.length(),
    cps.keys() == checkpoints.keys(),
    log' = log.slice(0, pos),
    checkpoints' = cps,
    appended' = [],
    effects' = effects,
    answered' = answered.exclude(lost),
    rewound' = true,
    warehousePicksRecords' = warehousePicksRecords,
    warehouseHoldCalls' = warehouseHoldCalls,
    warehouseHoldRecords' = warehouseHoldRecords,
    billingBillCalls' = billingBillCalls,
  }

  // an operator's resume (`<app> resume`): the processors go on from their
  // checkpoints, and the effect steps and calls of the triggers after them
  // are forgotten: those triggers are handled again (at least once, under
  // the same key, or a key of its own where the position was given back
  // and filled by another event; at most once, again: the operator's
  // decision). What the dependencies applied stays (their records)
  action gristResumed: bool = all {
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects.select(e => e._2 <= checkpoints.get(e._1)),
    answered' = answered,
    rewound' = false,
    warehousePicksRecords' = warehousePicksRecords,
    warehouseHoldCalls' = warehouseHoldCalls.select(c => c.trigger <= checkpoints.get(c.processor)),
    warehouseHoldRecords' = warehouseHoldRecords,
    billingBillCalls' = billingBillCalls.select(c => c.trigger <= checkpoints.get(c.processor)),
  }

  // The rules (grist.NewRule), run on the events an ok decision appends, on
  // its reads, before the append: their verdicts so far (the first refusal,
  // "" for none, and the reads of every rule that ran), and a guarded
  // command's (its decision's outcome, then its rules')
  type RuleVerdict = { refusal: str, needs: Set[Read] }
  type CommandVerdict = { decided: str, outcome: str, needs: Set[Read] }
  pure val noRule: RuleVerdict = { refusal: "", needs: Set() }

  // rule open-shop on item-added, after acc: no verdict once one refused
  pure def openShopRuled(log: List[Event], e: Event, acc: RuleVerdict): RuleVerdict =
    val refusal = if (acc.refusal != "" or e.typ != "item-added") "" else openShopRefusal(log, e)
    if (acc.refusal != "" or e.typ != "item-added") acc
    else { refusal: refusal, needs: acc.needs.union(openShopNeeds(e, refusal)) }

  // the rules on b's events, in batch order, an event's in registration
  // order: the first refusal wins
  pure def rulesOf(log: List[Event], b: List[Event]): RuleVerdict =
    b.foldl(noRule, (acc, e) => openShopRuled(log, e, acc))

  // add-item's outcome: its decision's (addItemOutcome), then, when ok, the
  // first refusal of its rules (open-shop) on what it appends (addItemEvents)
  pure def addItemRuled(log: List[Event], c: AddItemArgs): CommandVerdict =
    val decided = addItemOutcome(log, c)
    val ruled = rulesOf(log, if (decided == "ok") addItemEvents(log, c) else [])
    { decided: decided, outcome: if (ruled.refusal != "") ruled.refusal else decided, needs: ruled.needs }

  // add-item: conditioned on its reads; refusals full, closed. Its outcome is
  // its decision's, then, when that is ok, the first refusal of the rules
  // guarding it (open-shop, addItemRuled); every committed outcome needs its
  // id fresh and its read set covering what its decision and every rule that
  // ran need; ok and a refusal need that outcome and the condition to have
  // held, a conflict needs it not to. A reused key commits nothing.
  action addItem(item_: str, qty: int, of_: str, id: str, caller: str, readPos: int, reads: Set[(str, str, str)], result: str): bool = {
    val args_: AddItemArgs = { item: item_, qty: qty, of: of_, caller: caller }
    val reads_ = readsOf(reads)
    val verdict_ = addItemRuled(log, args_)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      addItemNeeds(args_, if (result != "conflict" and verdict_.decided == "ok") "ok" else result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == verdict_.outcome,
        verdict_.needs.forall(n => covers(reads_, n)),
        if (result == "ok") appends(caused(addItemEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // note-item: Unconditioned (notes are advisory): its reads are advisory,
  // its precondition is the rule's alone; no refusal. Every committed outcome
  // needs its id fresh and its read set covering what its rule needs; ok and
  // a refusal need the rule's outcome. A reused key commits nothing.
  action noteItem(item_: str, id: str, caller: str, readPos: int, reads: Set[(str, str, str)], result: str): bool = {
    val args_: NoteItemArgs = { item: item_, caller: caller }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      noteItemNeeds(args_, result).forall(n => covers(reads_, n)),
      0 <= readPos,
      result == noteItemOutcome(log, args_),
      if (result == "ok") appends(caused(noteItemEvents(log, args_), ("command", id)), id)
      else refuses(readPos, id),
    }
  }

  // count: reads through readPos, changes nothing; its answer is countAnswer's
  // at its position (the binding's expect)
  action count(readPos: int): bool = readsThrough(readPos)

  // show-item: reads through readPos, changes nothing; its answer is showItemAnswer's
  // at its position (the binding's expect)
  action showItem(item_: str, readPos: int): bool = readsThrough(readPos)

  // ship (Emits): on each item-added, shipEmits of the log through the trigger,
  // with its checkpoint (whatever came after the trigger)
  action ship(trigger: int): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("ship"), "item-added"),
    processes(caused(shipEmits(log.slice(0, trigger), trigger), ("processor", "ship")), "ship", trigger),
  }

  // notify's success event for trigger, caused by it (notifySuccess's)
  pure def notifySucceeded(log: List[Event], trigger: int): List[Event] =
    caused(notifySuccess(log.slice(0, trigger), trigger), ("processor", "notify"))

  // notify skips a trigger its rule says it skips (notifySkips: the handler's Skip),
  // its checkpoint alone, no effect step; a handler's Fail is recorded so
  // too, appending grist.failed, which a skip's empty batch does not match
  action notifySkip(trigger: int): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("notify"), "item-added"),
    notifySkips(log.slice(0, trigger), trigger),
    triesOf(effects, "notify", trigger) == 0,
    processes([], "notify", trigger),
  }

  // notify's effect, at least once: any number of tries for its next trigger
  // before its checkpoint, every one under the trigger's key
  action notifyEffect(trigger: int, key: str, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("notify"), "item-added"),
    not(notifySkips(log.slice(0, trigger), trigger)),
    effectStep("notify", trigger, key, ok),
  }

  // notify's checkpoint, only after effect steps: its success after an ok one,
  // grist.failed after 2 failed ones, whichever the run committed (ok: its
  // record of which)
  action notify(trigger: int, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("notify"), "item-added"),
    atLeastOnceDone(effects, "notify", trigger, ok, 2),
    processes(atLeastOnceOutcome("notify", trigger, ok, notifySucceeded(log, trigger)), "notify", trigger),
  }

  // notify is at least once: its outcome commits with its checkpoint, never
  // alone, so an outcome step of its own is no step of this model
  action notifyOutcome(trigger: int, ok: bool): bool = all {
    false,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    rewound' = rewound,
    warehousePicksRecords' = warehousePicksRecords,
    warehouseHoldCalls' = warehouseHoldCalls,
    warehouseHoldRecords' = warehouseHoldRecords,
    billingBillCalls' = billingBillCalls,
  }

  // charge skips a trigger its rule says it skips (chargeSkips: the handler's Skip),
  // its checkpoint alone, no effect step; a handler's Fail is recorded so
  // too, appending grist.failed, which a skip's empty batch does not match
  action chargeSkip(trigger: int): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("charge"), "item-shipped"),
    chargeSkips(log.slice(0, trigger), trigger),
    triesOf(effects, "charge", trigger) == 0,
    processes([], "charge", trigger),
  }

  // charge, at most once: its checkpoint first (ok false, nothing appended),
  // before any effect step of its trigger
  action charge(trigger: int, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("charge"), "item-shipped"),
    not(chargeSkips(log.slice(0, trigger), trigger)),
    atMostOnceFirst(effects, "charge", trigger, ok),
    processes([], "charge", trigger),
  }

  // charge's effect: once, after its checkpoint, or never (a crash between
  // the two loses it, by right)
  action chargeEffect(trigger: int, key: str, ok: bool): bool = all {
    trigger > 0 and trigger <= log.length() and log[trigger - 1].typ == "item-shipped",
    not(chargeSkips(log.slice(0, trigger), trigger)),
    atMostOnceEffect(effects, checkpoints.get("charge"), "charge", trigger),
    effectStep("charge", trigger, key, ok),
  }

  // charge's outcome, if present (a crash after the effect loses it): its
  // success after the one ok effect step; after a failed one grist.failed
  // when the failure is known, else grist.unknown with the error
  action chargeOutcome(trigger: int, ok: bool, known: bool, error: str): bool = {
    val isTrigger = trigger > 0 and trigger <= log.length() and log[trigger - 1].typ == "item-shipped"
    val success = if (isTrigger) [] else []
    all {
      isTrigger,
      not(rewound),
      atMostOnceDone(log, effects, "charge", trigger, ok, success),
      val b = atMostOnceOutcome("charge", trigger, ok, known, error, success)
      all {
        log' = log.concat(b),
        checkpoints' = checkpoints,
        appended' = b,
        effects' = effects,
        answered' = answered,
        rewound' = rewound,
        warehousePicksRecords' = warehousePicksRecords,
        warehouseHoldCalls' = warehouseHoldCalls,
        warehouseHoldRecords' = warehouseHoldRecords,
        billingBillCalls' = billingBillCalls,
      },
    }
  }

  // invoice skips a trigger its rule says it skips (invoiceSkips: the handler's Skip),
  // its checkpoint alone, no effect step; a handler's Fail is recorded so
  // too, appending grist.failed, which a skip's empty batch does not match
  action invoiceSkip(trigger: int): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("invoice"), "item-shipped"),
    invoiceSkips(log.slice(0, trigger), trigger),
    triesOf(effects, "invoice", trigger) == 0,
    processes([], "invoice", trigger),
  }

  // invoice's effect, at least once: any number of tries for its next trigger
  // before its checkpoint, every one under the trigger's key
  action invoiceEffect(trigger: int, key: str, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("invoice"), "item-shipped"),
    not(invoiceSkips(log.slice(0, trigger), trigger)),
    effectStep("invoice", trigger, key, ok),
  }

  // invoice's checkpoint, only after effect steps: its success after an ok one,
  // grist.failed after 3 failed ones, whichever the run committed (ok: its
  // record of which)
  action invoice(trigger: int, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("invoice"), "item-shipped"),
    atLeastOnceDone(effects, "invoice", trigger, ok, 3),
    processes(atLeastOnceOutcome("invoice", trigger, ok, []), "invoice", trigger),
  }

  // invoice is at least once: its outcome commits with its checkpoint, never
  // alone, so an outcome step of its own is no step of this model
  action invoiceOutcome(trigger: int, ok: bool): bool = all {
    false,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    rewound' = rewound,
    warehousePicksRecords' = warehousePicksRecords,
    warehouseHoldCalls' = warehouseHoldCalls,
    warehouseHoldRecords' = warehouseHoldRecords,
    billingBillCalls' = billingBillCalls,
  }

  // the warehouse-picks site's record, made where its effect took place: any number,
  // in any order with the steps that asked for them, as warehousePicksAdmits allows
  action warehousePicks(key: str, item_: str, qty: int): bool = {
    val rec_: WarehousePicksRecord = { key: key, item: item_, qty: qty }
    all {
      warehousePicksAdmits(warehousePicksRecords, rec_),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      rewound' = rewound,
      warehousePicksRecords' = warehousePicksRecords.append(rec_),
      warehouseHoldCalls' = warehouseHoldCalls,
      warehouseHoldRecords' = warehouseHoldRecords,
      billingBillCalls' = billingBillCalls,
    }
  }

  // the keys of warehouse/hold's steps: (processor, trigger, key)
  pure def warehouseHoldKeys(l: List[WarehouseHoldRecord]): List[CallKey] = l.foldl([], (acc, c) => acc.append((c.processor, c.trigger, c.key)))

  // the warehouse dependency applies each key once (Keyed): no earlier record
  // of the key; the application's rules may define warehouseHoldAdmits
  // instead, reading only prefix (the log through the trigger)
  pure def warehouseHoldAdmits(prefix: List[Event], records: List[WarehouseHoldRecord], r: WarehouseHoldRecord): bool = not(keyCalled(warehouseHoldKeys(records), r.key))

  // warehouse/hold as its caller saw it (Call.Do: invoked before the request,
  // done with the answer, the outcome ok, a declared refusal or unknown):
  // from an effect of a processor that uses it, for one of its triggers
  // before the effect step, under the trigger's key (callKeyStable), its
  // request the processor's rule's, at most once with no earlier call of the
  // key
  action warehouseHold(processor: str, trigger: int, key: str, item_: str, qty: int, result: str, ref: str): bool = {
    val rec_: WarehouseHoldRecord = { processor: processor, trigger: trigger, key: key, request: { item: item_, qty: qty }, result: result, response: { ref: ref } }
    all {
      or {
        processor == "notify" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "item-added",
          rec_.request == notifyWarehouseHold(log.slice(0, trigger), trigger),
          not(notifySkips(log.slice(0, trigger), trigger)),
          trigger == nextOf(log, checkpoints.get("notify"), "item-added"),
        } else false),
        processor == "charge" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "item-shipped",
          rec_.request == chargeWarehouseHold(log.slice(0, trigger), trigger),
          not(chargeSkips(log.slice(0, trigger), trigger)),
          checkpoints.get("charge") >= trigger,
          triesOf(effects, "charge", trigger) == 0,
          not(keyCalled(warehouseHoldKeys(warehouseHoldCalls), key)),
        } else false),
      },
      callKeyStable(effects, warehouseHoldKeys(warehouseHoldCalls), processor, trigger, key),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      rewound' = rewound,
      warehousePicksRecords' = warehousePicksRecords,
      warehouseHoldCalls' = warehouseHoldCalls.append(rec_),
      warehouseHoldRecords' = warehouseHoldRecords,
      billingBillCalls' = billingBillCalls,
    }
  }

  // warehouse/hold as the dependency applied it (its served record, placed at
  // its cause: after the commit holding its trigger): for one of a user's
  // triggers, its request the processor's rule's (as the caller's: a caller
  // crashed during the call leaves the served record the request's only one),
  // as warehouseHoldAdmits allows given the log through the trigger
  action warehouseHoldServed(processor: str, trigger: int, key: str, item_: str, qty: int, result: str, ref: str): bool = {
    val rec_: WarehouseHoldRecord = { processor: processor, trigger: trigger, key: key, request: { item: item_, qty: qty }, result: result, response: { ref: ref } }
    all {
      or {
        processor == "notify" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "item-added",
          rec_.request == notifyWarehouseHold(log.slice(0, trigger), trigger),
          not(notifySkips(log.slice(0, trigger), trigger)),
          warehouseHoldAdmits(log.slice(0, trigger), warehouseHoldRecords, rec_),
        } else false),
        processor == "charge" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "item-shipped",
          rec_.request == chargeWarehouseHold(log.slice(0, trigger), trigger),
          not(chargeSkips(log.slice(0, trigger), trigger)),
          warehouseHoldAdmits(log.slice(0, trigger), warehouseHoldRecords, rec_),
        } else false),
      },
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      rewound' = rewound,
      warehousePicksRecords' = warehousePicksRecords,
      warehouseHoldCalls' = warehouseHoldCalls,
      warehouseHoldRecords' = warehouseHoldRecords.append(rec_),
      billingBillCalls' = billingBillCalls,
    }
  }

  // warehouse/hold answered again from an application (grist.Replayed: a
  // dependency answering a retry of a key from its first answer): an earlier
  // served record, request and answer alike; it applies nothing
  action warehouseHoldReplayed(processor: str, trigger: int, key: str, item_: str, qty: int, result: str, ref: str): bool = {
    val rec_: WarehouseHoldRecord = { processor: processor, trigger: trigger, key: key, request: { item: item_, qty: qty }, result: result, response: { ref: ref } }
    all {
      or {
        processor == "notify" and (if (trigger > 0 and trigger <= log.length()) log[trigger - 1].typ == "item-added" else false),
        processor == "charge" and (if (trigger > 0 and trigger <= log.length()) log[trigger - 1].typ == "item-shipped" else false),
      },
      warehouseHoldRecords.indices().exists(i => warehouseHoldRecords[i] == rec_),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      rewound' = rewound,
      warehousePicksRecords' = warehousePicksRecords,
      warehouseHoldCalls' = warehouseHoldCalls,
      warehouseHoldRecords' = warehouseHoldRecords,
      billingBillCalls' = billingBillCalls,
    }
  }

  // the keys of billing/bill's steps: (processor, trigger, key)
  pure def billingBillKeys(l: List[BillingBillRecord]): List[CallKey] = l.foldl([], (acc, c) => acc.append((c.processor, c.trigger, c.key)))

  // billing/bill as its caller saw it (Call.Do: invoked before the request,
  // done with the answer, the outcome ok, a declared refusal or unknown):
  // from an effect of a processor that uses it, for one of its triggers
  // before the effect step, under the trigger's key (callKeyStable), its
  // request the processor's rule's
  action billingBill(processor: str, trigger: int, key: str, item_: str, qty: int, result: str): bool = {
    val rec_: BillingBillRecord = { processor: processor, trigger: trigger, key: key, request: { item: item_, qty: qty }, result: result, response: { unit: true } }
    all {
      or {
        processor == "invoice" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "item-shipped",
          rec_.request == invoiceBillingBill(log.slice(0, trigger), trigger),
          not(invoiceSkips(log.slice(0, trigger), trigger)),
          trigger == nextOf(log, checkpoints.get("invoice"), "item-shipped"),
        } else false),
      },
      callKeyStable(effects, billingBillKeys(billingBillCalls), processor, trigger, key),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      rewound' = rewound,
      warehousePicksRecords' = warehousePicksRecords,
      warehouseHoldCalls' = warehouseHoldCalls,
      warehouseHoldRecords' = warehouseHoldRecords,
      billingBillCalls' = billingBillCalls.append(rec_),
    }
  }

  // The obligations the catalog implies (docs/grist.md §3.3.1): eventual
  // vals, judged by the store's bindings at a settle beside the app's own
  // (the default binding's, and a variant's that judges every invariant of
  // the default binding, a call's where it judges the call's served records)

  // after a settle, ship (Emits) has handled every item-added: its checkpoint
  // passed it, with the events it emitted, a Skip's none or a Fail's
  // grist.failed
  val shipEventuallyHandled =
    log.indices().forall(i => log[i].typ == "item-added" implies checkpoints.get("ship") >= i + 1)

  // after a settle, notify (at least once) has handled every item-added: its
  // checkpoint passed it, and it was skipped (notifySkips), had an ok effect
  // step, or failed every try (its grist.failed)
  val notifyEventuallyHandled =
    log.indices().forall(i => log[i].typ == "item-added" implies and {
      checkpoints.get("notify") >= i + 1,
      or {
        notifySkips(log.slice(0, i + 1), i + 1),
        effectsOf(effects, "notify", i + 1, true) > 0,
        holds(log, failed("notify", i + 1)),
      },
    })

  // after a settle, charge (at most once) has handled every item-shipped: its
  // checkpoint passed it. The checkpoint commits first, and a crash after it
  // loses the effect or its outcome by right, so no outcome is promised (an
  // application states one test-only: atMostOnceOutcomesLogged)
  val chargeEventuallyHandled =
    log.indices().forall(i => log[i].typ == "item-shipped" implies checkpoints.get("charge") >= i + 1)

  // after a settle, invoice (at least once) has handled every item-shipped:
  // its checkpoint passed it, and it was skipped (invoiceSkips), had an ok
  // effect step, or failed every try (its grist.failed)
  val invoiceEventuallyHandled =
    log.indices().forall(i => log[i].typ == "item-shipped" implies and {
      checkpoints.get("invoice") >= i + 1,
      or {
        invoiceSkips(log.slice(0, i + 1), i + 1),
        effectsOf(effects, "invoice", i + 1, true) > 0,
        holds(log, failed("invoice", i + 1)),
      },
    })

  // after a settle, every call of warehouse/hold (Keyed, used by notify,
  // charge) its caller saw answered, ok or refused, has the dependency's
  // served record of its key; an unknown answer promises nothing (the request
  // may have been lost)
  val warehouseHoldEventuallyServed =
    warehouseHoldCalls.indices().forall(i => warehouseHoldCalls[i].result != "unknown" implies
      warehouseHoldRecords.indices().exists(j => warehouseHoldRecords[j].key == warehouseHoldCalls[i].key))

  // the model on its own (gotogether simulate): every command as its rule
  // decides, reading what it needs, every query, processor and site, each
  // drawing its own arguments (one draw shared by every block would make
  // the step's successors the product of all their domains)
  action step = {
    any {
      {
        nondet item_ = STRS.oneOf()
        nondet qty = INTS.oneOf()
        nondet of_ = STRS.oneOf()
        nondet caller = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        {
          val args_: AddItemArgs = { item: item_, qty: qty, of: of_, caller: caller }
          val verdict_ = addItemRuled(log, args_)
          val result_ = verdict_.outcome
          addItem(item_, qty, of_, id, caller, log.length(), triplesOf(addItemNeeds(args_, if (verdict_.decided == "ok") "ok" else result_).union(verdict_.needs)), result_)
        }
      },
      {
        nondet item_ = STRS.oneOf()
        nondet caller = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        {
          val args_: NoteItemArgs = { item: item_, caller: caller }
          val result_ = noteItemOutcome(log, args_)
          noteItem(item_, id, caller, log.length(), triplesOf(noteItemNeeds(args_, result_)), result_)
        }
      },
      count(log.length()),
      {
        nondet item_ = STRS.oneOf()
        showItem(item_, log.length())
      },
      ship(nextOf(log, checkpoints.get("ship"), "item-added")),
      notifySkip(nextOf(log, checkpoints.get("notify"), "item-added")),
      {
        nondet key_ = KEYS.oneOf()
        nondet ok_ = Bool.oneOf()
        notifyEffect(nextOf(log, checkpoints.get("notify"), "item-added"), key_, ok_)
      },
      {
        nondet ok_ = Bool.oneOf()
        notify(nextOf(log, checkpoints.get("notify"), "item-added"), ok_)
      },
      chargeSkip(nextOf(log, checkpoints.get("charge"), "item-shipped")),
      charge(nextOf(log, checkpoints.get("charge"), "item-shipped"), false),
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet ok_ = Bool.oneOf()
        chargeEffect(trigger_, key_, ok_)
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet ok_ = Bool.oneOf()
        nondet known_ = Bool.oneOf()
        chargeOutcome(trigger_, ok_, known_, "lost")
      },
      invoiceSkip(nextOf(log, checkpoints.get("invoice"), "item-shipped")),
      {
        nondet key_ = KEYS.oneOf()
        nondet ok_ = Bool.oneOf()
        invoiceEffect(nextOf(log, checkpoints.get("invoice"), "item-shipped"), key_, ok_)
      },
      {
        nondet ok_ = Bool.oneOf()
        invoice(nextOf(log, checkpoints.get("invoice"), "item-shipped"), ok_)
      },
      {
        nondet key = STRS.oneOf()
        nondet item_ = STRS.oneOf()
        nondet qty = INTS.oneOf()
        warehousePicks(key, item_, qty)
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "no-stock", "unknown").oneOf()
        nondet ref = STRS.oneOf()
        {
          val req_: WarehouseHoldRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "item-added") notifyWarehouseHold(log.slice(0, trigger_), trigger_) else { item: "", qty: 0 }
          warehouseHold("notify", trigger_, key_, req_.item, req_.qty, result_, ref)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "no-stock").oneOf()
        nondet ref = STRS.oneOf()
        {
          val req_: WarehouseHoldRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "item-added") notifyWarehouseHold(log.slice(0, trigger_), trigger_) else { item: "", qty: 0 }
          warehouseHoldServed("notify", trigger_, key_, req_.item, req_.qty, result_, ref)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "no-stock").oneOf()
        nondet ref = STRS.oneOf()
        {
          val req_: WarehouseHoldRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "item-added") notifyWarehouseHold(log.slice(0, trigger_), trigger_) else { item: "", qty: 0 }
          warehouseHoldReplayed("notify", trigger_, key_, req_.item, req_.qty, result_, ref)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "no-stock", "unknown").oneOf()
        nondet ref = STRS.oneOf()
        {
          val req_: WarehouseHoldRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "item-shipped") chargeWarehouseHold(log.slice(0, trigger_), trigger_) else { item: "", qty: 0 }
          warehouseHold("charge", trigger_, key_, req_.item, req_.qty, result_, ref)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "no-stock").oneOf()
        nondet ref = STRS.oneOf()
        {
          val req_: WarehouseHoldRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "item-shipped") chargeWarehouseHold(log.slice(0, trigger_), trigger_) else { item: "", qty: 0 }
          warehouseHoldServed("charge", trigger_, key_, req_.item, req_.qty, result_, ref)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "no-stock").oneOf()
        nondet ref = STRS.oneOf()
        {
          val req_: WarehouseHoldRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "item-shipped") chargeWarehouseHold(log.slice(0, trigger_), trigger_) else { item: "", qty: 0 }
          warehouseHoldReplayed("charge", trigger_, key_, req_.item, req_.qty, result_, ref)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "no-account", "unknown").oneOf()
        {
          val req_: BillingBillRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "item-shipped") invoiceBillingBill(log.slice(0, trigger_), trigger_) else { item: "", qty: 0 }
          billingBill("invoice", trigger_, key_, req_.item, req_.qty, result_)
        }
      },
    }
  }
}

// The clients' side (shop.calls.binding.yaml): every call where a client
// saw it (actor <app>/<tenant>/clients), linearized by qtest.Linearize: no
// positions, no processors, the log the commands' events alone. A key's first
// answer is final here too; a call the API denied (403) answers nothing.
module shopCallsGen {
  import grist.* from "./grist"
  import shopEvents.* from "./shop_gen"
  import shopRules.* from "./shop_rules"
  export grist.*
  export shopEvents.*
  export shopRules.*

  var log: List[Event]
  var answered: Set[str]

  action init = all { log' = [], answered' = Set() }

  pure val IDS = ["i1", "i2", "i3", "i4", "i5", "i6", "i7", "i8", "i9", "i10", "i11", "i12", "i13", "i14", "i15", "i16", "i17", "i18", "i19", "i20", "i21", "i22", "i23", "i24", "i25", "i26", "i27", "i28", "i29", "i30"]
  // the next identity a command answers (none once all are): the first
  // unanswered, so that the model on its own never draws a used one (a
  // command that would be disabled) nor two that differ only by name
  pure def nextID(answered: Set[str]): Set[str] =
    IDS.foldl(Set(), (s, i) => if (s == Set() and not(answered.contains(i))) Set(i) else s)

  action answers(b: List[Event], id: str): bool = all {
    freshKey(answered, id),
    log' = log.concat(b),
    answered' = answered.union(Set(id)),
  }

  // a call the API refused (403: the block's policy refused the caller) ran
  // nothing and answers nothing: its key stays unanswered
  action denied: bool = all { log' = log, answered' = answered }

  // The rules (grist.NewRule), run on the events an ok decision appends, on
  // its reads, before the append: their verdicts so far (the first refusal,
  // "" for none, and the reads of every rule that ran), and a guarded
  // command's (its decision's outcome, then its rules')
  type RuleVerdict = { refusal: str, needs: Set[Read] }
  type CommandVerdict = { decided: str, outcome: str, needs: Set[Read] }
  pure val noRule: RuleVerdict = { refusal: "", needs: Set() }

  // rule open-shop on item-added, after acc: no verdict once one refused
  pure def openShopRuled(log: List[Event], e: Event, acc: RuleVerdict): RuleVerdict =
    val refusal = if (acc.refusal != "" or e.typ != "item-added") "" else openShopRefusal(log, e)
    if (acc.refusal != "" or e.typ != "item-added") acc
    else { refusal: refusal, needs: acc.needs.union(openShopNeeds(e, refusal)) }

  // the rules on b's events, in batch order, an event's in registration
  // order: the first refusal wins
  pure def rulesOf(log: List[Event], b: List[Event]): RuleVerdict =
    b.foldl(noRule, (acc, e) => openShopRuled(log, e, acc))

  // add-item's outcome: its decision's (addItemOutcome), then, when ok, the
  // first refusal of its rules (open-shop) on what it appends (addItemEvents)
  pure def addItemRuled(log: List[Event], c: AddItemArgs): CommandVerdict =
    val decided = addItemOutcome(log, c)
    val ruled = rulesOf(log, if (decided == "ok") addItemEvents(log, c) else [])
    { decided: decided, outcome: if (ruled.refusal != "") ruled.refusal else decided, needs: ruled.needs }

  action addItem(item_: str, qty: int, of_: str, id: str, caller: str, result: str): bool = {
    val args_: AddItemArgs = { item: item_, qty: qty, of: of_, caller: caller }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == addItemRuled(log, args_).outcome,
      answers(if (result == "ok") caused(addItemEvents(log, args_), ("command", id)) else [], id),
    }
  }

  action noteItem(item_: str, id: str, caller: str, result: str): bool = {
    val args_: NoteItemArgs = { item: item_, caller: caller }
    if (result == "denied") denied
    else all {
      result == noteItemOutcome(log, args_),
      answers(if (result == "ok") caused(noteItemEvents(log, args_), ("command", id)) else [], id),
    }
  }

  // count changes nothing; its answer is countAnswer's where it linearizes
  action count: bool = all { log' = log, answered' = answered }

  // show-item changes nothing; its answer is showItemAnswer's where it linearizes
  action showItem(item_: str): bool = all { log' = log, answered' = answered }

  action step = {
    any {
      {
        nondet item_ = STRS.oneOf()
        nondet qty = INTS.oneOf()
        nondet of_ = STRS.oneOf()
        nondet caller = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        addItem(item_, qty, of_, id, caller, addItemRuled(log, { item: item_, qty: qty, of: of_, caller: caller }).outcome)
      },
      {
        nondet item_ = STRS.oneOf()
        nondet caller = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        noteItem(item_, id, caller, noteItemOutcome(log, { item: item_, caller: caller }))
      },
      count,
      {
        nondet item_ = STRS.oneOf()
        showItem(item_)
      },
      all { log' = log, answered' = answered },
    }
  }
}
