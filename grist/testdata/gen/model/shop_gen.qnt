// Generated by grist model from the shop App's catalog (docs/grist.md §3.2):
// do not edit. Regenerate with the app's binary (`<app> model`, grist.Main)
// after changing a block; the application's rules are model/shop.qnt's.

// The events, reads and argument records: what the rules (module shopRules)
// and the invariants are written with.
module shopEvents {
  import grist.* from "./grist"
  export grist.*

  // item-added (strs: its strings, ints: its integers and booleans, in field order)
  pure def itemAdded(item_: str, qty: int, gift: bool): Event =
    { typ: "item-added", strs: [item_], ints: [qty, if (gift) 1 else 0], tags: Set(("item", item_), ("gift", if (gift) "true" else "false")), cause: UNCAUSED }
  pure def itemAddedItem(e: Event): str = e.strs[0]
  pure def itemAddedQty(e: Event): int = e.ints[0]
  pure def itemAddedGift(e: Event): bool = e.ints[1] == 1
  pure val itemAddedRead: Read = { typ: "item-added", tags: Set() }
  pure def itemAddedByItem(v: str): Read = { typ: "item-added", tags: Set(("item", v)) }
  pure def itemAddedByGift(v: str): Read = { typ: "item-added", tags: Set(("gift", v)) }

  // item-shipped (strs: its strings, ints: its integers and booleans, in field order)
  pure def itemShipped(item_: str, of_: int): Event =
    { typ: "item-shipped", strs: [item_], ints: [of_], tags: Set(("item", item_)), cause: UNCAUSED }
  pure def itemShippedItem(e: Event): str = e.strs[0]
  pure def itemShippedOf(e: Event): int = e.ints[0]
  pure val itemShippedRead: Read = { typ: "item-shipped", tags: Set() }
  pure def itemShippedByItem(v: str): Read = { typ: "item-shipped", tags: Set(("item", v)) }

  // item-noted (strs: its strings, ints: its integers and booleans, in field order)
  pure val itemNoted: Event =
    { typ: "item-noted", strs: [], ints: [], tags: Set(), cause: UNCAUSED }
  pure val itemNotedRead: Read = { typ: "item-noted", tags: Set() }

  // read model stock (keyed by item: the events of its types carrying those
  // tags): what it folds, and what a read of it records
  pure def stockEvents(log: List[Event], k1: str): List[Event] = log.select(e => Set("item-added").contains(e.typ) and e.tags.contains(("item", k1)))
  pure def stockReads(k1: str): Set[Read] = Set({ typ: "item-added", tags: Set(("item", k1)) })

  // read model items (plain: every event of its types): what it folds, and
  // what a read of it records
  pure def itemsEvents(log: List[Event]): List[Event] = log.select(e => Set("item-added").contains(e.typ))
  pure val itemsReads: Set[Read] = Set({ typ: "item-added", tags: Set() })

  // each command's and query's arguments, with the actor that sent it (principal)
  type AddItemArgs = { item: str, qty: int, of: str, principal: str }
  type NoteItemArgs = { item: str, principal: str }
  type CountArgs = { principal: str }
  type ShowItemArgs = { item: str, principal: str }
  type ShowItemResult = { qty: int, shipped: bool }
  // site warehouse-picks: a record of the effect, made where it takes place
  type WarehousePicksRecord = { key: str, item: str, qty: int }
}

// The store's side (shop.binding.yaml): every step where it took effect, one
// tenant's log. Commits are relayed from the store's step log, refusals
// recorded at their commit, queries on return, effects by their processors,
// sites by the dependencies that make them.
module shopGen {
  import grist.* from "./grist"
  import shopEvents.*
  import shopRules.* from "./shop"
  export grist.*
  export shopEvents.*
  export shopRules.*

  // one tenant's log
  var log: List[Event]
  // each processor's checkpoint: the last trigger it handled
  var checkpoints: str -> int
  // the batch the last step appended (what its observations are checked against)
  var appended: List[Event]
  // the effect steps: (processor, trigger, key, ok)
  var effects: List[Effect]
  // the command ids answered so far, by a commit or a committed refusal
  var answered: Set[str]
  // what the warehouse-picks site recorded, in order
  var warehousePicksRecords: List[WarehousePicksRecord]

  action init = all {
    log' = [],
    checkpoints' = Map("ship" -> 0, "notify" -> 0, "charge" -> 0),
    appended' = [],
    effects' = [],
    answered' = Set(),
    warehousePicksRecords' = [],
  }

  // the identities and effect keys the model on its own draws
  pure val IDS = Set("i1", "i2", "i3", "i4")
  pure val KEYS = Set("k1", "k2", "k3")

  // a command's commit of b, answering id
  action appends(b: List[Event], id: str): bool = all {
    log' = log.concat(b),
    checkpoints' = checkpoints,
    appended' = b,
    effects' = effects,
    answered' = answered.union(Set(id)),
    warehousePicksRecords' = warehousePicksRecords,
  }

  // a committed refusal: its marker answers id, nothing is appended; it
  // commits at the head, at or after the position it read through
  action refuses(readPos: int, id: str): bool = all {
    readPos <= log.length(),
    appends([], id),
  }

  // a step that commits nothing (a query, a reused key): it read through
  // readPos, the log's length where it is ordered (2·readPos+1)
  action readsThrough(readPos: int): bool = all {
    log.length() == readPos,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    warehousePicksRecords' = warehousePicksRecords,
  }

  // a processor's handling of trigger, appending b with its checkpoint
  action processes(b: List[Event], p: str, trigger: int): bool = all {
    log' = log.concat(b),
    checkpoints' = checkpoints.set(p, trigger),
    appended' = b,
    effects' = effects,
    answered' = answered,
    warehousePicksRecords' = warehousePicksRecords,
  }

  // an effect step of processor p for trigger, under key (the same on every
  // effect step of the trigger, no other trigger's: keyStable)
  action effectStep(p: str, trigger: int, key: str, ok: bool): bool = all {
    keyStable(effects, p, trigger, key),
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects.append((p, trigger, key, ok)),
    answered' = answered,
    warehousePicksRecords' = warehousePicksRecords,
  }

  // add-item: conditioned on its reads; refusals full. Every committed
  // outcome needs its id fresh and its read set covering what its rule needs;
  // ok and a refusal need the rule's outcome and the condition to have held,
  // a conflict needs it not to. A reused key commits nothing.
  action addItem(item_: str, qty: int, of_: str, id: str, principal: str, readPos: int, reads: List[(str, str, str)], result: str): bool = {
    val args_: AddItemArgs = { item: item_, qty: qty, of: of_, principal: principal }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      addItemNeeds(args_, result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == addItemOutcome(log, args_),
        if (result == "ok") appends(caused(addItemEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // note-item: Unconditioned (notes are advisory): its reads are advisory,
  // its precondition is the rule's alone; no refusal. Every committed outcome
  // needs its id fresh and its read set covering what its rule needs; ok and
  // a refusal need the rule's outcome. A reused key commits nothing.
  action noteItem(item_: str, id: str, principal: str, readPos: int, reads: List[(str, str, str)], result: str): bool = {
    val args_: NoteItemArgs = { item: item_, principal: principal }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      noteItemNeeds(args_, result).forall(n => covers(reads_, n)),
      0 <= readPos,
      result == noteItemOutcome(log, args_),
      if (result == "ok") appends(caused(noteItemEvents(log, args_), ("command", id)), id)
      else refuses(readPos, id),
    }
  }

  // count: reads through readPos, changes nothing; its answer is countAnswer's
  // at its position (the binding's expect)
  action count(readPos: int): bool = readsThrough(readPos)

  // show-item: reads through readPos, changes nothing; its answer is showItemAnswer's
  // at its position (the binding's expect)
  action showItem(item_: str, readPos: int): bool = readsThrough(readPos)

  // ship (Emits): on each item-added, shipEmits of the log through the trigger,
  // with its checkpoint (whatever came after the trigger)
  action ship(trigger: int): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("ship"), "item-added"),
    processes(caused(shipEmits(log.slice(0, trigger), trigger), ("processor", "ship")), "ship", trigger),
  }

  // notify's success event for trigger, caused by it (notifySuccess's)
  pure def notifySucceeded(log: List[Event], trigger: int): List[Event] =
    caused(notifySuccess(log.slice(0, trigger), trigger), ("processor", "notify"))

  // notify's effect, at least once: any number of tries for its next trigger
  // before its checkpoint, every one under the trigger's key
  action notifyEffect(trigger: int, key: str, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("notify"), "item-added"),
    effectStep("notify", trigger, key, ok),
  }

  // notify's checkpoint, only after effect steps: its success after an ok one,
  // grist.failed after 2 failed ones, whichever the run committed (ok: its
  // record of which)
  action notify(trigger: int, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("notify"), "item-added"),
    atLeastOnceDone(effects, "notify", trigger, ok, 2),
    processes(atLeastOnceOutcome("notify", trigger, ok, notifySucceeded(log, trigger)), "notify", trigger),
  }

  // notify is at least once: its outcome commits with its checkpoint, never
  // alone, so an outcome step of its own is no step of this model
  action notifyOutcome(trigger: int, ok: bool): bool = all {
    false,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    warehousePicksRecords' = warehousePicksRecords,
  }

  // charge, at most once: its checkpoint first (ok false, nothing appended),
  // before any effect step of its trigger
  action charge(trigger: int, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("charge"), "item-shipped"),
    atMostOnceFirst(effects, "charge", trigger, ok),
    processes([], "charge", trigger),
  }

  // charge's effect: once, after its checkpoint, or never (a crash between
  // the two loses it, by right)
  action chargeEffect(trigger: int, key: str, ok: bool): bool = all {
    trigger > 0 and trigger <= log.length() and log[trigger - 1].typ == "item-shipped",
    atMostOnceEffect(effects, checkpoints.get("charge"), "charge", trigger),
    effectStep("charge", trigger, key, ok),
  }

  // charge's outcome, if present (a crash after the effect loses it): its
  // success after the one ok effect step; after a failed one grist.failed
  // when the failure is known, else grist.unknown with the error
  action chargeOutcome(trigger: int, ok: bool, known: bool, error: str): bool = {
    val isTrigger = trigger > 0 and trigger <= log.length() and log[trigger - 1].typ == "item-shipped"
    val success = if (isTrigger) [] else []
    all {
      isTrigger,
      atMostOnceDone(log, effects, "charge", trigger, ok, success),
      val b = atMostOnceOutcome("charge", trigger, ok, known, error, success)
      all {
        log' = log.concat(b),
        checkpoints' = checkpoints,
        appended' = b,
        effects' = effects,
        answered' = answered,
        warehousePicksRecords' = warehousePicksRecords,
      },
    }
  }

  // the warehouse-picks site's record, made where its effect took place: any number,
  // in any order with the steps that asked for them, as warehousePicksAdmits allows
  action warehousePicks(key: str, item_: str, qty: int): bool = {
    val rec_: WarehousePicksRecord = { key: key, item: item_, qty: qty }
    all {
      warehousePicksAdmits(warehousePicksRecords, rec_),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      warehousePicksRecords' = warehousePicksRecords.append(rec_),
    }
  }

  // the model on its own (gotogether simulate): every command as its rule
  // decides, reading what it needs, every query, processor and site
  action step = {
    nondet item_ = STRS.oneOf()
    nondet qty = INTS.oneOf()
    nondet of_ = STRS.oneOf()
    nondet principal = STRS.oneOf()
    nondet id = IDS.oneOf()
    nondet key_ = KEYS.oneOf()
    nondet ok_ = Bool.oneOf()
    nondet known_ = Bool.oneOf()
    nondet trigger_ = 1.to(log.length() + 1).oneOf()
    nondet key = STRS.oneOf()
    any {
      {
        val args_: AddItemArgs = { item: item_, qty: qty, of: of_, principal: principal }
        val result_ = addItemOutcome(log, args_)
        addItem(item_, qty, of_, id, principal, log.length(), triplesOf(addItemNeeds(args_, result_)), result_)
      },
      {
        val args_: NoteItemArgs = { item: item_, principal: principal }
        val result_ = noteItemOutcome(log, args_)
        noteItem(item_, id, principal, log.length(), triplesOf(noteItemNeeds(args_, result_)), result_)
      },
      count(log.length()),
      showItem(item_, log.length()),
      ship(nextOf(log, checkpoints.get("ship"), "item-added")),
      notifyEffect(nextOf(log, checkpoints.get("notify"), "item-added"), key_, ok_),
      notify(nextOf(log, checkpoints.get("notify"), "item-added"), ok_),
      charge(nextOf(log, checkpoints.get("charge"), "item-shipped"), false),
      chargeEffect(trigger_, key_, ok_),
      chargeOutcome(trigger_, ok_, known_, "lost"),
      warehousePicks(key, item_, qty),
    }
  }
}

// The clients' side (shop.calls.binding.yaml): every call where a client
// saw it (actor <tenant>/clients), linearized by qtest.Linearize: no
// positions, no processors, the log the commands' events alone. A key's first
// answer is final here too; a call the API denied (403) answers nothing.
module shopCallsGen {
  import grist.* from "./grist"
  import shopEvents.*
  import shopRules.* from "./shop"
  export grist.*
  export shopEvents.*
  export shopRules.*

  var log: List[Event]
  var answered: Set[str]

  action init = all { log' = [], answered' = Set() }

  pure val IDS = Set("i1", "i2", "i3")

  action answers(b: List[Event], id: str): bool = all {
    freshKey(answered, id),
    log' = log.concat(b),
    answered' = answered.union(Set(id)),
  }

  // a call the API refused (403: the block's policy refused the actor) ran
  // nothing and answers nothing: its key stays unanswered
  action denied: bool = all { log' = log, answered' = answered }

  action addItem(item_: str, qty: int, of_: str, id: str, principal: str, result: str): bool = {
    val args_: AddItemArgs = { item: item_, qty: qty, of: of_, principal: principal }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == addItemOutcome(log, args_),
      answers(if (result == "ok") caused(addItemEvents(log, args_), ("command", id)) else [], id),
    }
  }

  action noteItem(item_: str, id: str, principal: str, result: str): bool = {
    val args_: NoteItemArgs = { item: item_, principal: principal }
    if (result == "denied") denied
    else all {
      result == noteItemOutcome(log, args_),
      answers(if (result == "ok") caused(noteItemEvents(log, args_), ("command", id)) else [], id),
    }
  }

  // count changes nothing; its answer is countAnswer's where it linearizes
  action count: bool = all { log' = log, answered' = answered }

  // show-item changes nothing; its answer is showItemAnswer's where it linearizes
  action showItem(item_: str): bool = all { log' = log, answered' = answered }

  action step = {
    nondet item_ = STRS.oneOf()
    nondet qty = INTS.oneOf()
    nondet of_ = STRS.oneOf()
    nondet principal = STRS.oneOf()
    nondet id = IDS.oneOf()
    any {
      addItem(item_, qty, of_, id, principal, addItemOutcome(log, { item: item_, qty: qty, of: of_, principal: principal })),
      noteItem(item_, id, principal, noteItemOutcome(log, { item: item_, principal: principal })),
      count,
      showItem(item_),
      all { log' = log, answered' = answered },
    }
  }
}
