# yaml-language-server: $schema={{.SchemaURL}}
# How the {{.Name}} service's recorded steps become calls of model/{{.Name}}.qnt's
# actions. reserve's parameters are the step's fields of the same names
# (sku, qty, result), so it needs no templates.
format: gotogether.binding/1
spec: model/{{.Name}}.qnt
module: {{.Name}}

constants:
  INITIAL: 'Map("apple" -> 2, "pear" -> 1)'   # as {{.Name}}.go's Initial

actions:
  reserve: {}

invariants: [neverOversold]

# the model on its own (gotogether simulate)
simulate:
  holds: [neverOversold]
  # what the model must be able to do, each a scenario a run should show:
  # a reservation that takes stock, and one refused
  possible:
    - 'reserve(result = "ok")'
    - name: a refusal after the stock ran out
      steps: ['reserve(result = "ok")', 'reserve(result = "refused")']
