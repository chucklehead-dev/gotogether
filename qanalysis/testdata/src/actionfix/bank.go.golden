// Package actionfix has quintaction's scope findings with their fixes:
// a local the function returns becomes its named result, a misspelled
// parameter is spelled as it; and one without (a local it does not
// return). Expectations sit in block comments before the directive.
package actionfix

import (
	"context"
	"errors"
)

// Bank keeps balances.
type Bank struct{ balances map[string]int }

/* want `open: obs.id uses id, which is not a parameter` */ //quint:action action:open owner:owner obs.id:id
func (b *Bank) Open(ctx context.Context, owner string) (id string, _ error) {
	id = owner + "-1"
	if owner == "" {
		return "", errors.New("no owner")
	}
	b.balances[id] = 0
	return id, nil
}

/* want `count: obs.n uses n, which is not a parameter` */ //quint:action action:count obs.n:n
func (b *Bank) Count() (n int) {

	for range b.balances {
		n++
	}
	return n
}

/* want `deposit: amount uses amont, which is not a parameter` */ //quint:action action:deposit account:account amount:amount
func (b *Bank) Deposit(ctx context.Context, account string, amount int) error {
	b.balances[account] += amount
	return nil
}

/* want `withdraw: obs.balance uses left, which is not a parameter` */ //quint:action action:withdraw account:account amount:amount obs.balance:left
func (b *Bank) Withdraw(ctx context.Context, account string, amount int) error {
	left := b.balances[account] - amount
	if left < 0 {
		return errors.New("overdraft")
	}
	b.balances[account] = left
	return nil
}
