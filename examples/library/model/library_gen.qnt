// Generated by grist model from the library App's catalog (docs/grist.md §3.2):
// do not edit. Regenerate with the app's binary (`<app> model`, grist.Main)
// after changing a block; the application's rules are model/library.qnt's.

// The events, reads and argument records: what the rules (module libraryRules)
// and the invariants are written with.
module libraryEvents {
  import grist.* from "./grist"
  export grist.*

  // member-joined (strs: its strings, ints: its integers and booleans, in field order)
  pure def memberJoined(member: str): Event =
    { typ: "member-joined", strs: [member], ints: [], tags: Set(("member", member)), cause: UNCAUSED }
  pure def memberJoinedMember(e: Event): str = e.strs[0]
  pure val memberJoinedRead: Read = { typ: "member-joined", tags: Set() }
  pure def memberJoinedByMember(v: str): Read = { typ: "member-joined", tags: Set(("member", v)) }

  // book-added (strs: its strings, ints: its integers and booleans, in field order)
  pure def bookAdded(book: str, copies: int): Event =
    { typ: "book-added", strs: [book], ints: [copies], tags: Set(("book", book)), cause: UNCAUSED }
  pure def bookAddedBook(e: Event): str = e.strs[0]
  pure def bookAddedCopies(e: Event): int = e.ints[0]
  pure val bookAddedRead: Read = { typ: "book-added", tags: Set() }
  pure def bookAddedByBook(v: str): Read = { typ: "book-added", tags: Set(("book", v)) }

  // book-borrowed (strs: its strings, ints: its integers and booleans, in field order)
  pure def bookBorrowed(member: str, book: str): Event =
    { typ: "book-borrowed", strs: [member, book], ints: [], tags: Set(("member", member), ("book", book)), cause: UNCAUSED }
  pure def bookBorrowedMember(e: Event): str = e.strs[0]
  pure def bookBorrowedBook(e: Event): str = e.strs[1]
  pure val bookBorrowedRead: Read = { typ: "book-borrowed", tags: Set() }
  pure def bookBorrowedByMember(v: str): Read = { typ: "book-borrowed", tags: Set(("member", v)) }
  pure def bookBorrowedByBook(v: str): Read = { typ: "book-borrowed", tags: Set(("book", v)) }

  // book-returned (strs: its strings, ints: its integers and booleans, in field order)
  pure def bookReturned(member: str, book: str): Event =
    { typ: "book-returned", strs: [member, book], ints: [], tags: Set(("member", member), ("book", book)), cause: UNCAUSED }
  pure def bookReturnedMember(e: Event): str = e.strs[0]
  pure def bookReturnedBook(e: Event): str = e.strs[1]
  pure val bookReturnedRead: Read = { typ: "book-returned", tags: Set() }
  pure def bookReturnedByMember(v: str): Read = { typ: "book-returned", tags: Set(("member", v)) }
  pure def bookReturnedByBook(v: str): Read = { typ: "book-returned", tags: Set(("book", v)) }

  // read model books (keyed by book: the events of its types carrying those
  // tags): what it folds, and what a read of it records
  pure def booksEvents(log: List[Event], book: str): List[Event] = log.select(e => Set("book-added", "book-borrowed", "book-returned").contains(e.typ) and e.tags.contains(("book", book)))
  pure def booksReads(book: str): Set[Read] = Set({ typ: "book-added", tags: Set(("book", book)) }, { typ: "book-borrowed", tags: Set(("book", book)) }, { typ: "book-returned", tags: Set(("book", book)) })

  // read model loans (keyed by member: the events of its types carrying those
  // tags): what it folds, and what a read of it records
  pure def loansEvents(log: List[Event], member: str): List[Event] = log.select(e => Set("book-borrowed", "book-returned").contains(e.typ) and e.tags.contains(("member", member)))
  pure def loansReads(member: str): Set[Read] = Set({ typ: "book-borrowed", tags: Set(("member", member)) }, { typ: "book-returned", tags: Set(("member", member)) })

  // each command's and query's arguments, with the actor that sent it (principal)
  type AddBookArgs = { book: str, copies: int, principal: str }
  type BorrowArgs = { member: str, book: str, principal: str }
  type JoinArgs = { member: str, principal: str }
  type ReturnBookArgs = { member: str, book: str, principal: str }
  type MemberLoansArgs = { member: str, principal: str }
  type MemberLoansResult = { count: int }
  // site mailer-sends: a record of the effect, made where it takes place
  type MailerSendsRecord = { member: str, book: str, at: int, key: str }
}

// The store's side (library.binding.yaml): every step where it took effect, one
// tenant's log. Commits are relayed from the store's step log, refusals
// recorded at their commit, queries on return, effects by their processors,
// sites by the dependencies that make them.
module libraryGen {
  import grist.* from "./grist"
  import libraryEvents.*
  import libraryRules.* from "./library"
  export grist.*
  export libraryEvents.*
  export libraryRules.*

  // one tenant's log
  var log: List[Event]
  // each processor's checkpoint: the last trigger it handled
  var checkpoints: str -> int
  // the batch the last step appended (what its observations are checked against)
  var appended: List[Event]
  // the effect steps: (processor, trigger, key, ok)
  var effects: List[Effect]
  // the command ids answered so far, by a commit or a committed refusal
  var answered: Set[str]
  // what the mailer-sends site recorded, in order
  var mailerSendsRecords: List[MailerSendsRecord]

  action init = all {
    log' = [],
    checkpoints' = Map("receipts" -> 0),
    appended' = [],
    effects' = [],
    answered' = Set(),
    mailerSendsRecords' = [],
  }

  // the identities and effect keys the model on its own draws
  pure val IDS = Set("i1", "i2", "i3", "i4")
  pure val KEYS = Set("k1", "k2", "k3")

  // a command's commit of b, answering id
  action appends(b: List[Event], id: str): bool = all {
    log' = log.concat(b),
    checkpoints' = checkpoints,
    appended' = b,
    effects' = effects,
    answered' = answered.union(Set(id)),
    mailerSendsRecords' = mailerSendsRecords,
  }

  // a committed refusal: its marker answers id, nothing is appended; it
  // commits at the head, at or after the position it read through
  action refuses(readPos: int, id: str): bool = all {
    readPos <= log.length(),
    appends([], id),
  }

  // a step that commits nothing (a query, a reused key): it read through
  // readPos, the log's length where it is ordered (2·readPos+1)
  action readsThrough(readPos: int): bool = all {
    log.length() == readPos,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    mailerSendsRecords' = mailerSendsRecords,
  }

  // a processor's handling of trigger, appending b with its checkpoint
  action processes(b: List[Event], p: str, trigger: int): bool = all {
    log' = log.concat(b),
    checkpoints' = checkpoints.set(p, trigger),
    appended' = b,
    effects' = effects,
    answered' = answered,
    mailerSendsRecords' = mailerSendsRecords,
  }

  // an effect step of processor p for trigger, under key (the same on every
  // effect step of the trigger, no other trigger's: keyStable)
  action effectStep(p: str, trigger: int, key: str, ok: bool): bool = all {
    keyStable(effects, p, trigger, key),
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects.append((p, trigger, key, ok)),
    answered' = answered,
    mailerSendsRecords' = mailerSendsRecords,
  }

  // add-book: conditioned on its reads; refusals invalid. Every committed
  // outcome needs its id fresh and its read set covering what its rule needs;
  // ok and a refusal need the rule's outcome and the condition to have held,
  // a conflict needs it not to. A reused key commits nothing.
  action addBook(book: str, copies: int, id: str, principal: str, readPos: int, reads: List[(str, str, str)], result: str): bool = {
    val args_: AddBookArgs = { book: book, copies: copies, principal: principal }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      addBookNeeds(args_, result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == addBookOutcome(log, args_),
        if (result == "ok") appends(caused(addBookEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // borrow: conditioned on its reads; refusals not-member, limit,
  // unavailable. Every committed outcome needs its id fresh and its read set
  // covering what its rule needs; ok and a refusal need the rule's outcome
  // and the condition to have held, a conflict needs it not to. A reused key
  // commits nothing.
  action borrow(member: str, book: str, id: str, principal: str, readPos: int, reads: List[(str, str, str)], result: str): bool = {
    val args_: BorrowArgs = { member: member, book: book, principal: principal }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      borrowNeeds(args_, result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == borrowOutcome(log, args_),
        if (result == "ok") appends(caused(borrowEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // join: conditioned on its reads; refusals already-member. Every committed
  // outcome needs its id fresh and its read set covering what its rule needs;
  // ok and a refusal need the rule's outcome and the condition to have held,
  // a conflict needs it not to. A reused key commits nothing.
  action join(member: str, id: str, principal: str, readPos: int, reads: List[(str, str, str)], result: str): bool = {
    val args_: JoinArgs = { member: member, principal: principal }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      joinNeeds(args_, result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == joinOutcome(log, args_),
        if (result == "ok") appends(caused(joinEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // return-book: conditioned on its reads; refusals not-held. Every committed
  // outcome needs its id fresh and its read set covering what its rule needs;
  // ok and a refusal need the rule's outcome and the condition to have held,
  // a conflict needs it not to. A reused key commits nothing.
  action returnBook(member: str, book: str, id: str, principal: str, readPos: int, reads: List[(str, str, str)], result: str): bool = {
    val args_: ReturnBookArgs = { member: member, book: book, principal: principal }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      returnBookNeeds(args_, result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == returnBookOutcome(log, args_),
        if (result == "ok") appends(caused(returnBookEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // member-loans: reads through readPos, changes nothing; its answer is memberLoansAnswer's
  // at its position (the binding's expect)
  action memberLoans(member: str, readPos: int): bool = readsThrough(readPos)

  // receipts's effect, at least once: any number of tries for its next trigger
  // before its checkpoint, every one under the trigger's key
  action receiptsEffect(trigger: int, key: str, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("receipts"), "book-borrowed"),
    effectStep("receipts", trigger, key, ok),
  }

  // receipts's checkpoint, only after effect steps: its success after an ok one,
  // grist.failed after 3 failed ones, whichever the run committed (ok: its
  // record of which)
  action receipts(trigger: int, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("receipts"), "book-borrowed"),
    atLeastOnceDone(effects, "receipts", trigger, ok, 3),
    processes(atLeastOnceOutcome("receipts", trigger, ok, []), "receipts", trigger),
  }

  // receipts is at least once: its outcome commits with its checkpoint, never
  // alone, so an outcome step of its own is no step of this model
  action receiptsOutcome(trigger: int, ok: bool): bool = all {
    false,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    mailerSendsRecords' = mailerSendsRecords,
  }

  // the mailer-sends site's record, made where its effect took place: any number,
  // in any order with the steps that asked for them, as mailerSendsAdmits allows
  action mailerSends(member: str, book: str, at: int, key: str): bool = {
    val rec_: MailerSendsRecord = { member: member, book: book, at: at, key: key }
    all {
      mailerSendsAdmits(mailerSendsRecords, rec_),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      mailerSendsRecords' = mailerSendsRecords.append(rec_),
    }
  }

  // the model on its own (gotogether simulate): every command as its rule
  // decides, reading what it needs, every query, processor and site
  action step = {
    nondet book = STRS.oneOf()
    nondet copies = INTS.oneOf()
    nondet principal = STRS.oneOf()
    nondet id = IDS.oneOf()
    nondet member = STRS.oneOf()
    nondet key_ = KEYS.oneOf()
    nondet ok_ = Bool.oneOf()
    nondet at = INTS.oneOf()
    nondet key = STRS.oneOf()
    any {
      {
        val args_: AddBookArgs = { book: book, copies: copies, principal: principal }
        val result_ = addBookOutcome(log, args_)
        addBook(book, copies, id, principal, log.length(), triplesOf(addBookNeeds(args_, result_)), result_)
      },
      {
        val args_: BorrowArgs = { member: member, book: book, principal: principal }
        val result_ = borrowOutcome(log, args_)
        borrow(member, book, id, principal, log.length(), triplesOf(borrowNeeds(args_, result_)), result_)
      },
      {
        val args_: JoinArgs = { member: member, principal: principal }
        val result_ = joinOutcome(log, args_)
        join(member, id, principal, log.length(), triplesOf(joinNeeds(args_, result_)), result_)
      },
      {
        val args_: ReturnBookArgs = { member: member, book: book, principal: principal }
        val result_ = returnBookOutcome(log, args_)
        returnBook(member, book, id, principal, log.length(), triplesOf(returnBookNeeds(args_, result_)), result_)
      },
      memberLoans(member, log.length()),
      receiptsEffect(nextOf(log, checkpoints.get("receipts"), "book-borrowed"), key_, ok_),
      receipts(nextOf(log, checkpoints.get("receipts"), "book-borrowed"), ok_),
      mailerSends(member, book, at, key),
    }
  }
}

// The clients' side (library.calls.binding.yaml): every call where a client
// saw it (actor <tenant>/clients), linearized by qtest.Linearize: no
// positions, no processors, the log the commands' events alone. A key's first
// answer is final here too; a call the API denied (403) answers nothing.
module libraryCallsGen {
  import grist.* from "./grist"
  import libraryEvents.*
  import libraryRules.* from "./library"
  export grist.*
  export libraryEvents.*
  export libraryRules.*

  var log: List[Event]
  var answered: Set[str]

  action init = all { log' = [], answered' = Set() }

  pure val IDS = Set("i1", "i2", "i3")

  action answers(b: List[Event], id: str): bool = all {
    freshKey(answered, id),
    log' = log.concat(b),
    answered' = answered.union(Set(id)),
  }

  // a call the API refused (403: the block's policy refused the actor) ran
  // nothing and answers nothing: its key stays unanswered
  action denied: bool = all { log' = log, answered' = answered }

  action addBook(book: str, copies: int, id: str, principal: str, result: str): bool = {
    val args_: AddBookArgs = { book: book, copies: copies, principal: principal }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == addBookOutcome(log, args_),
      answers(if (result == "ok") caused(addBookEvents(log, args_), ("command", id)) else [], id),
    }
  }

  action borrow(member: str, book: str, id: str, principal: str, result: str): bool = {
    val args_: BorrowArgs = { member: member, book: book, principal: principal }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == borrowOutcome(log, args_),
      answers(if (result == "ok") caused(borrowEvents(log, args_), ("command", id)) else [], id),
    }
  }

  action join(member: str, id: str, principal: str, result: str): bool = {
    val args_: JoinArgs = { member: member, principal: principal }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == joinOutcome(log, args_),
      answers(if (result == "ok") caused(joinEvents(log, args_), ("command", id)) else [], id),
    }
  }

  action returnBook(member: str, book: str, id: str, principal: str, result: str): bool = {
    val args_: ReturnBookArgs = { member: member, book: book, principal: principal }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == returnBookOutcome(log, args_),
      answers(if (result == "ok") caused(returnBookEvents(log, args_), ("command", id)) else [], id),
    }
  }

  // member-loans changes nothing; its answer is memberLoansAnswer's where it linearizes
  action memberLoans(member: str): bool = all { log' = log, answered' = answered }

  action step = {
    nondet book = STRS.oneOf()
    nondet copies = INTS.oneOf()
    nondet principal = STRS.oneOf()
    nondet id = IDS.oneOf()
    nondet member = STRS.oneOf()
    any {
      addBook(book, copies, id, principal, addBookOutcome(log, { book: book, copies: copies, principal: principal })),
      borrow(member, book, id, principal, borrowOutcome(log, { member: member, book: book, principal: principal })),
      join(member, id, principal, joinOutcome(log, { member: member, principal: principal })),
      returnBook(member, book, id, principal, returnBookOutcome(log, { member: member, book: book, principal: principal })),
      memberLoans(member),
      all { log' = log, answered' = answered },
    }
  }
}
