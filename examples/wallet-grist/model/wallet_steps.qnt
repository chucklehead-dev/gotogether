// Generated by grist model from the wallet App's catalog (docs/grist.md §3.2):
// do not edit. Regenerate with the app's binary (`<app> model`, grist.Main)
// after changing a block; the application's rules are model/wallet_rules.qnt's,
// its invariants model/wallet.qnt's.

// The store's side (wallet.binding.yaml): every step where it took effect, one
// tenant's log. Commits are relayed from the store's step log, refusals
// recorded at their commit, queries on return, effects by their processors,
// sites by the dependencies that make them.
module walletGen {
  import grist.* from "./grist"
  import walletEvents.* from "./wallet_gen"
  import walletRules.* from "./wallet_rules"
  export grist.*
  export walletEvents.*
  export walletRules.*

  // one tenant's log
  var log: List[Event]
  // each processor's checkpoint: the last trigger it handled
  var checkpoints: str -> int
  // the batch the last step appended (what its observations are checked against)
  var appended: List[Event]
  // the effect steps: (processor, trigger, key, ok)
  var effects: List[Effect]
  // the command ids answered so far, by a commit or a committed refusal
  var answered: Set[str]
  // the calls of ledger/post as their callers saw them (Call.Do), and as the dependency
  // applied them (its served records), in order
  var ledgerPostCalls: List[LedgerPostRecord]
  var ledgerPostRecords: List[LedgerPostRecord]

  action init = all {
    log' = [],
    checkpoints' = Map("post" -> 0),
    appended' = [],
    effects' = [],
    answered' = Set(),
    ledgerPostCalls' = [],
    ledgerPostRecords' = [],
  }

  // the identities, in the order commands take them, and the effect keys the
  // model on its own draws
  pure val IDS = ["i1", "i2", "i3", "i4", "i5", "i6", "i7", "i8", "i9", "i10", "i11", "i12", "i13", "i14", "i15", "i16", "i17", "i18", "i19", "i20", "i21", "i22", "i23", "i24", "i25", "i26", "i27", "i28", "i29", "i30"]
  pure val KEYS = Set("k1", "k2", "k3")
  // the next identity a command answers (none once all are): the first
  // unanswered, so that the model on its own never draws a used one (a
  // command that would be disabled) nor two that differ only by name
  pure def nextID(answered: Set[str]): Set[str] =
    IDS.foldl(Set(), (s, i) => if (s == Set() and not(answered.contains(i))) Set(i) else s)

  // a command's commit of b, answering id
  action appends(b: List[Event], id: str): bool = all {
    log' = log.concat(b),
    checkpoints' = checkpoints,
    appended' = b,
    effects' = effects,
    answered' = answered.union(Set(id)),
    ledgerPostCalls' = ledgerPostCalls,
    ledgerPostRecords' = ledgerPostRecords,
  }

  // a committed refusal: its marker answers id, nothing is appended; it
  // commits at the head, at or after the position it read through
  action refuses(readPos: int, id: str): bool = all {
    readPos <= log.length(),
    appends([], id),
  }

  // a step that commits nothing (a query, a reused key): it read through
  // readPos, the log's length where it is ordered (2·readPos+1)
  action readsThrough(readPos: int): bool = all {
    log.length() == readPos,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    ledgerPostCalls' = ledgerPostCalls,
    ledgerPostRecords' = ledgerPostRecords,
  }

  // a processor's handling of trigger, appending b with its checkpoint
  action processes(b: List[Event], p: str, trigger: int): bool = all {
    log' = log.concat(b),
    checkpoints' = checkpoints.set(p, trigger),
    appended' = b,
    effects' = effects,
    answered' = answered,
    ledgerPostCalls' = ledgerPostCalls,
    ledgerPostRecords' = ledgerPostRecords,
  }

  // an effect step of processor p for trigger, under key (the same on every
  // effect step of the trigger, no other trigger's: keyStable)
  action effectStep(p: str, trigger: int, key: str, ok: bool): bool = all {
    keyStable(effects, p, trigger, key),
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects.append((p, trigger, key, ok)),
    answered' = answered,
    ledgerPostCalls' = ledgerPostCalls,
    ledgerPostRecords' = ledgerPostRecords,
  }

  // deposit: conditioned on its reads; refusals invalid. Every committed
  // outcome needs its id fresh and its read set covering what its rule needs;
  // ok and a refusal need the rule's outcome and the condition to have held,
  // a conflict needs it not to. A reused key commits nothing.
  action deposit(account: str, amount: int, id: str, principal: str, readPos: int, reads: Set[(str, str, str)], result: str): bool = {
    val args_: DepositArgs = { account: account, amount: amount, principal: principal }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      depositNeeds(args_, result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == depositOutcome(log, args_),
        if (result == "ok") appends(caused(depositEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // transfer: conditioned on its reads; refusals invalid, insufficient-funds.
  // Every committed outcome needs its id fresh and its read set covering what
  // its rule needs; ok and a refusal need the rule's outcome and the
  // condition to have held, a conflict needs it not to. A reused key commits
  // nothing.
  action transfer(src: str, dest: str, amount: int, id: str, principal: str, readPos: int, reads: Set[(str, str, str)], result: str): bool = {
    val args_: TransferArgs = { src: src, dest: dest, amount: amount, principal: principal }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      transferNeeds(args_, result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == transferOutcome(log, args_),
        if (result == "ok") appends(caused(transferEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // read: reads through readPos, changes nothing; its answer is readAnswer's
  // at its position (the binding's expect)
  action read(account: str, readPos: int): bool = readsThrough(readPos)

  // post's success event for trigger, caused by it (postSuccess's)
  pure def postSucceeded(log: List[Event], trigger: int): List[Event] =
    caused(postSuccess(log.slice(0, trigger), trigger), ("processor", "post"))

  // post skips a trigger its rule says it skips (postSkips: the handler's Skip),
  // its checkpoint alone, no effect step; a handler's Fail is recorded so
  // too, appending grist.failed, which a skip's empty batch does not match
  action postSkip(trigger: int): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("post"), "moved"),
    postSkips(log.slice(0, trigger), trigger),
    triesOf(effects, "post", trigger) == 0,
    processes([], "post", trigger),
  }

  // post's effect, at least once: any number of tries for its next trigger
  // before its checkpoint, every one under the trigger's key
  action postEffect(trigger: int, key: str, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("post"), "moved"),
    not(postSkips(log.slice(0, trigger), trigger)),
    effectStep("post", trigger, key, ok),
  }

  // post's checkpoint, only after effect steps: its success after an ok one,
  // grist.failed after 3 failed ones, whichever the run committed (ok: its
  // record of which)
  action post(trigger: int, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("post"), "moved"),
    atLeastOnceDone(effects, "post", trigger, ok, 3),
    processes(atLeastOnceOutcome("post", trigger, ok, postSucceeded(log, trigger)), "post", trigger),
  }

  // post is at least once: its outcome commits with its checkpoint, never
  // alone, so an outcome step of its own is no step of this model
  action postOutcome(trigger: int, ok: bool): bool = all {
    false,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    ledgerPostCalls' = ledgerPostCalls,
    ledgerPostRecords' = ledgerPostRecords,
  }

  // the keys of ledger/post's steps: (processor, trigger, key)
  pure def ledgerPostKeys(l: List[LedgerPostRecord]): List[CallKey] = l.foldl([], (acc, c) => acc.append((c.processor, c.trigger, c.key)))

  // the ledger dependency applies each key once (Keyed): no earlier record of
  // the key; the application's rules may define ledgerPostAdmits instead,
  // reading only prefix (the log through the trigger)
  pure def ledgerPostAdmits(prefix: List[Event], records: List[LedgerPostRecord], r: LedgerPostRecord): bool = not(keyCalled(ledgerPostKeys(records), r.key))

  // ledger/post as its caller saw it (Call.Do: invoked before the request,
  // done with the answer, the outcome ok, a declared refusal or unknown):
  // from an effect of a processor that uses it, for one of its triggers
  // before the effect step, under the trigger's key (callKeyStable), its
  // request the processor's rule's
  action ledgerPost(processor: str, trigger: int, key: str, account: str, amount: int, result: str): bool = {
    val rec_: LedgerPostRecord = { processor: processor, trigger: trigger, key: key, request: { account: account, amount: amount }, result: result, response: { unit: true } }
    all {
      or {
        processor == "post" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "moved",
          rec_.request == postLedgerPost(log.slice(0, trigger), trigger),
          not(postSkips(log.slice(0, trigger), trigger)),
          trigger == nextOf(log, checkpoints.get("post"), "moved"),
        } else false),
      },
      callKeyStable(effects, ledgerPostKeys(ledgerPostCalls), processor, trigger, key),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      ledgerPostCalls' = ledgerPostCalls.append(rec_),
      ledgerPostRecords' = ledgerPostRecords,
    }
  }

  // ledger/post as the dependency applied it (its served record, placed at
  // its cause: after the commit holding its trigger): for one of a user's
  // triggers, its request the processor's rule's (as the caller's: a caller
  // crashed during the call leaves the served record the request's only one),
  // as ledgerPostAdmits allows given the log through the trigger
  action ledgerPostServed(processor: str, trigger: int, key: str, account: str, amount: int, result: str): bool = {
    val rec_: LedgerPostRecord = { processor: processor, trigger: trigger, key: key, request: { account: account, amount: amount }, result: result, response: { unit: true } }
    all {
      or {
        processor == "post" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "moved",
          rec_.request == postLedgerPost(log.slice(0, trigger), trigger),
          not(postSkips(log.slice(0, trigger), trigger)),
          ledgerPostAdmits(log.slice(0, trigger), ledgerPostRecords, rec_),
        } else false),
      },
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      ledgerPostCalls' = ledgerPostCalls,
      ledgerPostRecords' = ledgerPostRecords.append(rec_),
    }
  }

  // ledger/post answered again from an application (grist.Replayed: a
  // dependency answering a retry of a key from its first answer): an earlier
  // served record, request and answer alike; it applies nothing
  action ledgerPostReplayed(processor: str, trigger: int, key: str, account: str, amount: int, result: str): bool = {
    val rec_: LedgerPostRecord = { processor: processor, trigger: trigger, key: key, request: { account: account, amount: amount }, result: result, response: { unit: true } }
    all {
      or {
        processor == "post" and (if (trigger > 0 and trigger <= log.length()) log[trigger - 1].typ == "moved" else false),
      },
      ledgerPostRecords.indices().exists(i => ledgerPostRecords[i] == rec_),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      ledgerPostCalls' = ledgerPostCalls,
      ledgerPostRecords' = ledgerPostRecords,
    }
  }

  // The obligations the catalog implies (docs/grist.md §3.3.1): eventual
  // vals, judged by the store's bindings at a settle beside the app's own
  // (the default binding's, and a variant's that judges every invariant of
  // the default binding)

  // after a settle, post (at least once) has handled every moved: its
  // checkpoint passed it, and it was skipped (postSkips), had an ok effect
  // step, or failed every try (its grist.failed)
  val postEventuallyHandled =
    log.indices().forall(i => log[i].typ == "moved" implies and {
      checkpoints.get("post") >= i + 1,
      or {
        postSkips(log.slice(0, i + 1), i + 1),
        effectsOf(effects, "post", i + 1, true) > 0,
        holds(log, failed("post", i + 1)),
      },
    })

  // after a settle, every call of ledger/post (Keyed, used by post) its
  // caller saw answered, ok or refused, has the dependency's served record of
  // its key; an unknown answer promises nothing (the request may have been
  // lost)
  val ledgerPostEventuallyServed =
    ledgerPostCalls.indices().forall(i => ledgerPostCalls[i].result != "unknown" implies
      ledgerPostRecords.indices().exists(j => ledgerPostRecords[j].key == ledgerPostCalls[i].key))

  // the model on its own (gotogether simulate): every command as its rule
  // decides, reading what it needs, every query, processor and site, each
  // drawing its own arguments (one draw shared by every block would make
  // the step's successors the product of all their domains)
  action step = {
    any {
      {
        nondet account = STRS.oneOf()
        nondet amount = INTS.oneOf()
        nondet principal = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        {
          val args_: DepositArgs = { account: account, amount: amount, principal: principal }
          val result_ = depositOutcome(log, args_)
          deposit(account, amount, id, principal, log.length(), triplesOf(depositNeeds(args_, result_)), result_)
        }
      },
      {
        nondet src = STRS.oneOf()
        nondet dest = STRS.oneOf()
        nondet amount = INTS.oneOf()
        nondet principal = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        {
          val args_: TransferArgs = { src: src, dest: dest, amount: amount, principal: principal }
          val result_ = transferOutcome(log, args_)
          transfer(src, dest, amount, id, principal, log.length(), triplesOf(transferNeeds(args_, result_)), result_)
        }
      },
      {
        nondet account = STRS.oneOf()
        read(account, log.length())
      },
      postSkip(nextOf(log, checkpoints.get("post"), "moved")),
      {
        nondet key_ = KEYS.oneOf()
        nondet ok_ = Bool.oneOf()
        postEffect(nextOf(log, checkpoints.get("post"), "moved"), key_, ok_)
      },
      {
        nondet ok_ = Bool.oneOf()
        post(nextOf(log, checkpoints.get("post"), "moved"), ok_)
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "unknown").oneOf()
        {
          val req_: LedgerPostRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "moved") postLedgerPost(log.slice(0, trigger_), trigger_) else { account: "", amount: 0 }
          ledgerPost("post", trigger_, key_, req_.account, req_.amount, result_)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok").oneOf()
        {
          val req_: LedgerPostRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "moved") postLedgerPost(log.slice(0, trigger_), trigger_) else { account: "", amount: 0 }
          ledgerPostServed("post", trigger_, key_, req_.account, req_.amount, result_)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok").oneOf()
        {
          val req_: LedgerPostRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "moved") postLedgerPost(log.slice(0, trigger_), trigger_) else { account: "", amount: 0 }
          ledgerPostReplayed("post", trigger_, key_, req_.account, req_.amount, result_)
        }
      },
    }
  }
}

// The clients' side (wallet.calls.binding.yaml): every call where a client
// saw it (actor <tenant>/clients), linearized by qtest.Linearize: no
// positions, no processors, the log the commands' events alone. A key's first
// answer is final here too; a call the API denied (403) answers nothing.
module walletCallsGen {
  import grist.* from "./grist"
  import walletEvents.* from "./wallet_gen"
  import walletRules.* from "./wallet_rules"
  export grist.*
  export walletEvents.*
  export walletRules.*

  var log: List[Event]
  var answered: Set[str]

  action init = all { log' = [], answered' = Set() }

  pure val IDS = ["i1", "i2", "i3", "i4", "i5", "i6", "i7", "i8", "i9", "i10", "i11", "i12", "i13", "i14", "i15", "i16", "i17", "i18", "i19", "i20", "i21", "i22", "i23", "i24", "i25", "i26", "i27", "i28", "i29", "i30"]
  // the next identity a command answers (none once all are): the first
  // unanswered, so that the model on its own never draws a used one (a
  // command that would be disabled) nor two that differ only by name
  pure def nextID(answered: Set[str]): Set[str] =
    IDS.foldl(Set(), (s, i) => if (s == Set() and not(answered.contains(i))) Set(i) else s)

  action answers(b: List[Event], id: str): bool = all {
    freshKey(answered, id),
    log' = log.concat(b),
    answered' = answered.union(Set(id)),
  }

  // a call the API refused (403: the block's policy refused the actor) ran
  // nothing and answers nothing: its key stays unanswered
  action denied: bool = all { log' = log, answered' = answered }

  action deposit(account: str, amount: int, id: str, principal: str, result: str): bool = {
    val args_: DepositArgs = { account: account, amount: amount, principal: principal }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == depositOutcome(log, args_),
      answers(if (result == "ok") caused(depositEvents(log, args_), ("command", id)) else [], id),
    }
  }

  action transfer(src: str, dest: str, amount: int, id: str, principal: str, result: str): bool = {
    val args_: TransferArgs = { src: src, dest: dest, amount: amount, principal: principal }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == transferOutcome(log, args_),
      answers(if (result == "ok") caused(transferEvents(log, args_), ("command", id)) else [], id),
    }
  }

  // read changes nothing; its answer is readAnswer's where it linearizes
  action read(account: str): bool = all { log' = log, answered' = answered }

  action step = {
    any {
      {
        nondet account = STRS.oneOf()
        nondet amount = INTS.oneOf()
        nondet principal = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        deposit(account, amount, id, principal, depositOutcome(log, { account: account, amount: amount, principal: principal }))
      },
      {
        nondet src = STRS.oneOf()
        nondet dest = STRS.oneOf()
        nondet amount = INTS.oneOf()
        nondet principal = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        transfer(src, dest, amount, id, principal, transferOutcome(log, { src: src, dest: dest, amount: amount, principal: principal }))
      },
      {
        nondet account = STRS.oneOf()
        read(account)
      },
      all { log' = log, answered' = answered },
    }
  }
}
