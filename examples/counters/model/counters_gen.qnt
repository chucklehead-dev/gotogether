// Generated by grist model from the counters App's catalog (docs/grist.md §3.2):
// do not edit. Regenerate with the app's binary (`<app> model`, grist.Main)
// after changing a block; the application's rules are model/counters.qnt's.

// The events, reads and argument records: what the rules (module countersRules)
// and the invariants are written with.
module countersEvents {
  import grist.* from "./grist"
  export grist.*

  // counter-created (strs: its strings, ints: its integers and booleans, in field order)
  pure def counterCreated(counter: str, name: str, creator: str): Event =
    { typ: "counter-created", strs: [counter, name, creator], ints: [], tags: Set(("counter", counter), ("name", name)), cause: UNCAUSED }
  pure def counterCreatedCounter(e: Event): str = e.strs[0]
  pure def counterCreatedName(e: Event): str = e.strs[1]
  pure def counterCreatedCreator(e: Event): str = e.strs[2]
  pure val counterCreatedRead: Read = { typ: "counter-created", tags: Set() }
  pure def counterCreatedByCounter(v: str): Read = { typ: "counter-created", tags: Set(("counter", v)) }
  pure def counterCreatedByName(v: str): Read = { typ: "counter-created", tags: Set(("name", v)) }

  // counter-incremented (strs: its strings, ints: its integers and booleans, in field order)
  pure def counterIncremented(counter: str, by: int): Event =
    { typ: "counter-incremented", strs: [counter], ints: [by], tags: Set(("counter", counter)), cause: UNCAUSED }
  pure def counterIncrementedCounter(e: Event): str = e.strs[0]
  pure def counterIncrementedBy(e: Event): int = e.ints[0]
  pure val counterIncrementedRead: Read = { typ: "counter-incremented", tags: Set() }
  pure def counterIncrementedByCounter(v: str): Read = { typ: "counter-incremented", tags: Set(("counter", v)) }

  // average-computed (strs: its strings, ints: its integers and booleans, in field order)
  pure def averageComputed(sum: int, count: int): Event =
    { typ: "average-computed", strs: [], ints: [sum, count], tags: Set(), cause: UNCAUSED }
  pure def averageComputedSum(e: Event): int = e.ints[0]
  pure def averageComputedCount(e: Event): int = e.ints[1]
  pure val averageComputedRead: Read = { typ: "average-computed", tags: Set() }

  // notified (strs: its strings, ints: its integers and booleans, in field order)
  pure def notified(counter: str): Event =
    { typ: "notified", strs: [counter], ints: [], tags: Set(("counter", counter)), cause: UNCAUSED }
  pure def notifiedCounter(e: Event): str = e.strs[0]
  pure val notifiedRead: Read = { typ: "notified", tags: Set() }
  pure def notifiedByCounter(v: str): Read = { typ: "notified", tags: Set(("counter", v)) }

  // counter-retired (strs: its strings, ints: its integers and booleans, in field order)
  pure def counterRetired(counter: str, total: int): Event =
    { typ: "counter-retired", strs: [counter], ints: [total], tags: Set(("counter", counter)), cause: UNCAUSED }
  pure def counterRetiredCounter(e: Event): str = e.strs[0]
  pure def counterRetiredTotal(e: Event): int = e.ints[0]
  pure val counterRetiredRead: Read = { typ: "counter-retired", tags: Set() }
  pure def counterRetiredByCounter(v: str): Read = { typ: "counter-retired", tags: Set(("counter", v)) }

  // paid-out (strs: its strings, ints: its integers and booleans, in field order)
  pure def paidOut(counter: str, retired: int): Event =
    { typ: "paid-out", strs: [counter], ints: [retired], tags: Set(("counter", counter)), cause: UNCAUSED }
  pure def paidOutCounter(e: Event): str = e.strs[0]
  pure def paidOutRetired(e: Event): int = e.ints[0]
  pure val paidOutRead: Read = { typ: "paid-out", tags: Set() }
  pure def paidOutByCounter(v: str): Read = { typ: "paid-out", tags: Set(("counter", v)) }

  // read model counter-names (plain: every event of its types): what it
  // folds, and what a read of it records
  pure def counterNamesEvents(log: List[Event]): List[Event] = log.select(e => Set("counter-created").contains(e.typ))
  pure val counterNamesReads: Set[Read] = Set({ typ: "counter-created", tags: Set() })

  // read model totals (keyed by counter: the events of its types carrying
  // those tags): what it folds, and what a read of it records
  pure def totalsEvents(log: List[Event], counter: str): List[Event] = log.select(e => Set("counter-incremented").contains(e.typ) and e.tags.contains(("counter", counter)))
  pure def totalsReads(counter: str): Set[Read] = Set({ typ: "counter-incremented", tags: Set(("counter", counter)) })

  // each command's and query's arguments, with the actor that sent it (principal)
  type CreateCounterArgs = { counter: str, name: str, principal: str }
  type IncrementCounterArgs = { counter: str, by: int, principal: str }
  type RetireCounterArgs = { counter: str, principal: str }
  type ShowCounterArgs = { counter: str, principal: str }
  type ShowCounterResult = { total: int, names: int }
  // call mailer/send: its request and response, and a step of it (the caller's or the site's: the outcome as result,
  // the response zero unless it is ok)
  type MailerSendRequest = { counter: str, name: str }
  type MailerSendResponse = { unit: bool }
  type MailerSendRecord = { processor: str, trigger: int, key: str, request: MailerSendRequest, result: str, response: MailerSendResponse }
  // call bank/pay: its request and response, and a step of it (the caller's or the site's: the outcome as result,
  // the response zero unless it is ok)
  type BankPayRequest = { counter: str, amount: int }
  type BankPayResponse = { ref: str }
  type BankPayRecord = { processor: str, trigger: int, key: str, request: BankPayRequest, result: str, response: BankPayResponse }
}

// The store's side (counters.binding.yaml): every step where it took effect, one
// tenant's log. Commits are relayed from the store's step log, refusals
// recorded at their commit, queries on return, effects by their processors,
// sites by the dependencies that make them.
module countersGen {
  import grist.* from "./grist"
  import countersEvents.*
  import countersRules.* from "./counters"
  export grist.*
  export countersEvents.*
  export countersRules.*

  // one tenant's log
  var log: List[Event]
  // each processor's checkpoint: the last trigger it handled
  var checkpoints: str -> int
  // the batch the last step appended (what its observations are checked against)
  var appended: List[Event]
  // the effect steps: (processor, trigger, key, ok)
  var effects: List[Effect]
  // the command ids answered so far, by a commit or a committed refusal
  var answered: Set[str]
  // the calls of mailer/send as their callers saw them (Call.Do), and as the dependency
  // applied them (its served records), in order
  var mailerSendCalls: List[MailerSendRecord]
  var mailerSendRecords: List[MailerSendRecord]
  // the calls of bank/pay as their callers saw them (Call.Do), and as the dependency
  // applied them (its served records), in order
  var bankPayCalls: List[BankPayRecord]
  var bankPayRecords: List[BankPayRecord]

  action init = all {
    log' = [],
    checkpoints' = Map("average" -> 0, "welcome" -> 0, "payout" -> 0),
    appended' = [],
    effects' = [],
    answered' = Set(),
    mailerSendCalls' = [],
    mailerSendRecords' = [],
    bankPayCalls' = [],
    bankPayRecords' = [],
  }

  // the identities and effect keys the model on its own draws
  pure val IDS = Set("i1", "i2", "i3", "i4")
  pure val KEYS = Set("k1", "k2", "k3")

  // a command's commit of b, answering id
  action appends(b: List[Event], id: str): bool = all {
    log' = log.concat(b),
    checkpoints' = checkpoints,
    appended' = b,
    effects' = effects,
    answered' = answered.union(Set(id)),
    mailerSendCalls' = mailerSendCalls,
    mailerSendRecords' = mailerSendRecords,
    bankPayCalls' = bankPayCalls,
    bankPayRecords' = bankPayRecords,
  }

  // a committed refusal: its marker answers id, nothing is appended; it
  // commits at the head, at or after the position it read through
  action refuses(readPos: int, id: str): bool = all {
    readPos <= log.length(),
    appends([], id),
  }

  // a step that commits nothing (a query, a reused key): it read through
  // readPos, the log's length where it is ordered (2·readPos+1)
  action readsThrough(readPos: int): bool = all {
    log.length() == readPos,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    mailerSendCalls' = mailerSendCalls,
    mailerSendRecords' = mailerSendRecords,
    bankPayCalls' = bankPayCalls,
    bankPayRecords' = bankPayRecords,
  }

  // a processor's handling of trigger, appending b with its checkpoint
  action processes(b: List[Event], p: str, trigger: int): bool = all {
    log' = log.concat(b),
    checkpoints' = checkpoints.set(p, trigger),
    appended' = b,
    effects' = effects,
    answered' = answered,
    mailerSendCalls' = mailerSendCalls,
    mailerSendRecords' = mailerSendRecords,
    bankPayCalls' = bankPayCalls,
    bankPayRecords' = bankPayRecords,
  }

  // an effect step of processor p for trigger, under key (the same on every
  // effect step of the trigger, no other trigger's: keyStable)
  action effectStep(p: str, trigger: int, key: str, ok: bool): bool = all {
    keyStable(effects, p, trigger, key),
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects.append((p, trigger, key, ok)),
    answered' = answered,
    mailerSendCalls' = mailerSendCalls,
    mailerSendRecords' = mailerSendRecords,
    bankPayCalls' = bankPayCalls,
    bankPayRecords' = bankPayRecords,
  }

  // create-counter: conditioned on its reads; refusals name-taken. Every
  // committed outcome needs its id fresh and its read set covering what its
  // rule needs; ok and a refusal need the rule's outcome and the condition to
  // have held, a conflict needs it not to. A reused key commits nothing.
  action createCounter(counter: str, name: str, id: str, principal: str, readPos: int, reads: Set[(str, str, str)], result: str): bool = {
    val args_: CreateCounterArgs = { counter: counter, name: name, principal: principal }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      createCounterNeeds(args_, result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == createCounterOutcome(log, args_),
        if (result == "ok") appends(caused(createCounterEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // increment-counter: conditioned on its reads; refusals unknown-counter.
  // Every committed outcome needs its id fresh and its read set covering what
  // its rule needs; ok and a refusal need the rule's outcome and the
  // condition to have held, a conflict needs it not to. A reused key commits
  // nothing.
  action incrementCounter(counter: str, by: int, id: str, principal: str, readPos: int, reads: Set[(str, str, str)], result: str): bool = {
    val args_: IncrementCounterArgs = { counter: counter, by: by, principal: principal }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      incrementCounterNeeds(args_, result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == incrementCounterOutcome(log, args_),
        if (result == "ok") appends(caused(incrementCounterEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // retire-counter: conditioned on its reads; refusals unknown-counter,
  // not-creator. Every committed outcome needs its id fresh and its read set
  // covering what its rule needs; ok and a refusal need the rule's outcome
  // and the condition to have held, a conflict needs it not to. A reused key
  // commits nothing.
  action retireCounter(counter: str, id: str, principal: str, readPos: int, reads: Set[(str, str, str)], result: str): bool = {
    val args_: RetireCounterArgs = { counter: counter, principal: principal }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      retireCounterNeeds(args_, result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == retireCounterOutcome(log, args_),
        if (result == "ok") appends(caused(retireCounterEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // show-counter: reads through readPos, changes nothing; its answer is showCounterAnswer's
  // at its position (the binding's expect)
  action showCounter(counter: str, readPos: int): bool = readsThrough(readPos)

  // average (Emits): on each counter-incremented, averageEmits of the log through the trigger,
  // with its checkpoint (whatever came after the trigger)
  action average(trigger: int): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("average"), "counter-incremented"),
    processes(caused(averageEmits(log.slice(0, trigger), trigger), ("processor", "average")), "average", trigger),
  }

  // welcome's success event for trigger, caused by it (welcomeSuccess's)
  pure def welcomeSucceeded(log: List[Event], trigger: int): List[Event] =
    caused(welcomeSuccess(log.slice(0, trigger), trigger), ("processor", "welcome"))

  // welcome skips a trigger its rule says it skips (welcomeSkips: the handler's Skip),
  // its checkpoint alone, no effect step; a handler's Fail is recorded so
  // too, appending grist.failed, which a skip's empty batch does not match
  action welcomeSkip(trigger: int): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("welcome"), "counter-created"),
    welcomeSkips(log.slice(0, trigger), trigger),
    triesOf(effects, "welcome", trigger) == 0,
    processes([], "welcome", trigger),
  }

  // welcome's effect, at least once: any number of tries for its next trigger
  // before its checkpoint, every one under the trigger's key
  action welcomeEffect(trigger: int, key: str, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("welcome"), "counter-created"),
    not(welcomeSkips(log.slice(0, trigger), trigger)),
    effectStep("welcome", trigger, key, ok),
  }

  // welcome's checkpoint, only after effect steps: its success after an ok one,
  // grist.failed after 3 failed ones, whichever the run committed (ok: its
  // record of which)
  action welcome(trigger: int, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("welcome"), "counter-created"),
    atLeastOnceDone(effects, "welcome", trigger, ok, 3),
    processes(atLeastOnceOutcome("welcome", trigger, ok, welcomeSucceeded(log, trigger)), "welcome", trigger),
  }

  // welcome is at least once: its outcome commits with its checkpoint, never
  // alone, so an outcome step of its own is no step of this model
  action welcomeOutcome(trigger: int, ok: bool): bool = all {
    false,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    mailerSendCalls' = mailerSendCalls,
    mailerSendRecords' = mailerSendRecords,
    bankPayCalls' = bankPayCalls,
    bankPayRecords' = bankPayRecords,
  }

  // payout's success event for trigger, caused by it (payoutSuccess's)
  pure def payoutSucceeded(log: List[Event], trigger: int): List[Event] =
    caused(payoutSuccess(log.slice(0, trigger), trigger), ("processor", "payout"))

  // payout skips a trigger its rule says it skips (payoutSkips: the handler's Skip),
  // its checkpoint alone, no effect step; a handler's Fail is recorded so
  // too, appending grist.failed, which a skip's empty batch does not match
  action payoutSkip(trigger: int): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("payout"), "counter-retired"),
    payoutSkips(log.slice(0, trigger), trigger),
    triesOf(effects, "payout", trigger) == 0,
    processes([], "payout", trigger),
  }

  // payout, at most once: its checkpoint first (ok false, nothing appended),
  // before any effect step of its trigger
  action payout(trigger: int, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("payout"), "counter-retired"),
    not(payoutSkips(log.slice(0, trigger), trigger)),
    atMostOnceFirst(effects, "payout", trigger, ok),
    processes([], "payout", trigger),
  }

  // payout's effect: once, after its checkpoint, or never (a crash between
  // the two loses it, by right)
  action payoutEffect(trigger: int, key: str, ok: bool): bool = all {
    trigger > 0 and trigger <= log.length() and log[trigger - 1].typ == "counter-retired",
    not(payoutSkips(log.slice(0, trigger), trigger)),
    atMostOnceEffect(effects, checkpoints.get("payout"), "payout", trigger),
    effectStep("payout", trigger, key, ok),
  }

  // payout's outcome, if present (a crash after the effect loses it): its
  // success after the one ok effect step; after a failed one grist.failed
  // when the failure is known, else grist.unknown with the error
  action payoutOutcome(trigger: int, ok: bool, known: bool, error: str): bool = {
    val isTrigger = trigger > 0 and trigger <= log.length() and log[trigger - 1].typ == "counter-retired"
    val success = if (isTrigger) payoutSucceeded(log, trigger) else []
    all {
      isTrigger,
      atMostOnceDone(log, effects, "payout", trigger, ok, success),
      val b = atMostOnceOutcome("payout", trigger, ok, known, error, success)
      all {
        log' = log.concat(b),
        checkpoints' = checkpoints,
        appended' = b,
        effects' = effects,
        answered' = answered,
        mailerSendCalls' = mailerSendCalls,
        mailerSendRecords' = mailerSendRecords,
        bankPayCalls' = bankPayCalls,
        bankPayRecords' = bankPayRecords,
      },
    }
  }

  // the keys of mailer/send's steps: (processor, trigger, key)
  pure def mailerSendKeys(l: List[MailerSendRecord]): List[CallKey] = l.foldl([], (acc, c) => acc.append((c.processor, c.trigger, c.key)))

  // the mailer dependency applies every call it gets (not Keyed): any record;
  // the application's rules may define mailerSendAdmits instead, reading only
  // prefix (the log through the trigger)
  pure def mailerSendAdmits(prefix: List[Event], records: List[MailerSendRecord], r: MailerSendRecord): bool = true

  // mailer/send as its caller saw it (Call.Do: invoked before the request,
  // done with the answer, the outcome ok, a declared refusal or unknown):
  // from an effect of a processor that uses it, for one of its triggers
  // before the effect step, under the trigger's key (callKeyStable), its
  // request the processor's rule's
  action mailerSend(processor: str, trigger: int, key: str, counter: str, name: str, result: str): bool = {
    val rec_: MailerSendRecord = { processor: processor, trigger: trigger, key: key, request: { counter: counter, name: name }, result: result, response: { unit: true } }
    all {
      or {
        processor == "welcome" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "counter-created",
          rec_.request == welcomeMailerSend(log.slice(0, trigger), trigger),
          not(welcomeSkips(log.slice(0, trigger), trigger)),
          trigger == nextOf(log, checkpoints.get("welcome"), "counter-created"),
        } else false),
      },
      callKeyStable(effects, mailerSendKeys(mailerSendCalls), processor, trigger, key),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      mailerSendCalls' = mailerSendCalls.append(rec_),
      mailerSendRecords' = mailerSendRecords,
      bankPayCalls' = bankPayCalls,
      bankPayRecords' = bankPayRecords,
    }
  }

  // mailer/send as the dependency applied it (its served record, placed at
  // its cause: after the commit holding its trigger): for one of a user's
  // triggers, its request the processor's rule's (as the caller's: a caller
  // crashed during the call leaves the served record the request's only one),
  // as mailerSendAdmits allows given the log through the trigger
  action mailerSendServed(processor: str, trigger: int, key: str, counter: str, name: str, result: str): bool = {
    val rec_: MailerSendRecord = { processor: processor, trigger: trigger, key: key, request: { counter: counter, name: name }, result: result, response: { unit: true } }
    all {
      or {
        processor == "welcome" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "counter-created",
          rec_.request == welcomeMailerSend(log.slice(0, trigger), trigger),
          not(welcomeSkips(log.slice(0, trigger), trigger)),
          mailerSendAdmits(log.slice(0, trigger), mailerSendRecords, rec_),
        } else false),
      },
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      mailerSendCalls' = mailerSendCalls,
      mailerSendRecords' = mailerSendRecords.append(rec_),
      bankPayCalls' = bankPayCalls,
      bankPayRecords' = bankPayRecords,
    }
  }

  // mailer/send answered again from an application (grist.Replayed: a
  // dependency answering a retry of a key from its first answer): an earlier
  // served record, request and answer alike; it applies nothing
  action mailerSendReplayed(processor: str, trigger: int, key: str, counter: str, name: str, result: str): bool = {
    val rec_: MailerSendRecord = { processor: processor, trigger: trigger, key: key, request: { counter: counter, name: name }, result: result, response: { unit: true } }
    all {
      or {
        processor == "welcome" and (if (trigger > 0 and trigger <= log.length()) log[trigger - 1].typ == "counter-created" else false),
      },
      mailerSendRecords.indices().exists(i => mailerSendRecords[i] == rec_),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      mailerSendCalls' = mailerSendCalls,
      mailerSendRecords' = mailerSendRecords,
      bankPayCalls' = bankPayCalls,
      bankPayRecords' = bankPayRecords,
    }
  }

  // the keys of bank/pay's steps: (processor, trigger, key)
  pure def bankPayKeys(l: List[BankPayRecord]): List[CallKey] = l.foldl([], (acc, c) => acc.append((c.processor, c.trigger, c.key)))

  // the bank dependency applies each key once (Keyed): no earlier record of
  // the key; the application's rules may define bankPayAdmits instead,
  // reading only prefix (the log through the trigger)
  pure def bankPayAdmits(prefix: List[Event], records: List[BankPayRecord], r: BankPayRecord): bool = not(keyCalled(bankPayKeys(records), r.key))

  // bank/pay as its caller saw it (Call.Do: invoked before the request, done
  // with the answer, the outcome ok, a declared refusal or unknown): from an
  // effect of a processor that uses it, for one of its triggers before the
  // effect step, under the trigger's key (callKeyStable), its request the
  // processor's rule's, at most once with no earlier call of the key
  action bankPay(processor: str, trigger: int, key: str, counter: str, amount: int, result: str, ref: str): bool = {
    val rec_: BankPayRecord = { processor: processor, trigger: trigger, key: key, request: { counter: counter, amount: amount }, result: result, response: { ref: ref } }
    all {
      or {
        processor == "payout" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "counter-retired",
          rec_.request == payoutBankPay(log.slice(0, trigger), trigger),
          not(payoutSkips(log.slice(0, trigger), trigger)),
          checkpoints.get("payout") >= trigger,
          triesOf(effects, "payout", trigger) == 0,
          not(keyCalled(bankPayKeys(bankPayCalls), key)),
        } else false),
      },
      callKeyStable(effects, bankPayKeys(bankPayCalls), processor, trigger, key),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      mailerSendCalls' = mailerSendCalls,
      mailerSendRecords' = mailerSendRecords,
      bankPayCalls' = bankPayCalls.append(rec_),
      bankPayRecords' = bankPayRecords,
    }
  }

  // bank/pay as the dependency applied it (its served record, placed at its
  // cause: after the commit holding its trigger): for one of a user's
  // triggers, its request the processor's rule's (as the caller's: a caller
  // crashed during the call leaves the served record the request's only one),
  // as bankPayAdmits allows given the log through the trigger
  action bankPayServed(processor: str, trigger: int, key: str, counter: str, amount: int, result: str, ref: str): bool = {
    val rec_: BankPayRecord = { processor: processor, trigger: trigger, key: key, request: { counter: counter, amount: amount }, result: result, response: { ref: ref } }
    all {
      or {
        processor == "payout" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "counter-retired",
          rec_.request == payoutBankPay(log.slice(0, trigger), trigger),
          not(payoutSkips(log.slice(0, trigger), trigger)),
          bankPayAdmits(log.slice(0, trigger), bankPayRecords, rec_),
        } else false),
      },
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      mailerSendCalls' = mailerSendCalls,
      mailerSendRecords' = mailerSendRecords,
      bankPayCalls' = bankPayCalls,
      bankPayRecords' = bankPayRecords.append(rec_),
    }
  }

  // bank/pay answered again from an application (grist.Replayed: a dependency
  // answering a retry of a key from its first answer): an earlier served
  // record, request and answer alike; it applies nothing
  action bankPayReplayed(processor: str, trigger: int, key: str, counter: str, amount: int, result: str, ref: str): bool = {
    val rec_: BankPayRecord = { processor: processor, trigger: trigger, key: key, request: { counter: counter, amount: amount }, result: result, response: { ref: ref } }
    all {
      or {
        processor == "payout" and (if (trigger > 0 and trigger <= log.length()) log[trigger - 1].typ == "counter-retired" else false),
      },
      bankPayRecords.indices().exists(i => bankPayRecords[i] == rec_),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      mailerSendCalls' = mailerSendCalls,
      mailerSendRecords' = mailerSendRecords,
      bankPayCalls' = bankPayCalls,
      bankPayRecords' = bankPayRecords,
    }
  }

  // the model on its own (gotogether simulate): every command as its rule
  // decides, reading what it needs, every query, processor and site, each
  // drawing its own arguments (one draw shared by every block would make
  // the step's successors the product of all their domains)
  action step = {
    any {
      {
        nondet counter = STRS.oneOf()
        nondet name = STRS.oneOf()
        nondet principal = STRS.oneOf()
        nondet id = IDS.oneOf()
        {
          val args_: CreateCounterArgs = { counter: counter, name: name, principal: principal }
          val result_ = createCounterOutcome(log, args_)
          createCounter(counter, name, id, principal, log.length(), triplesOf(createCounterNeeds(args_, result_)), result_)
        }
      },
      {
        nondet counter = STRS.oneOf()
        nondet by = INTS.oneOf()
        nondet principal = STRS.oneOf()
        nondet id = IDS.oneOf()
        {
          val args_: IncrementCounterArgs = { counter: counter, by: by, principal: principal }
          val result_ = incrementCounterOutcome(log, args_)
          incrementCounter(counter, by, id, principal, log.length(), triplesOf(incrementCounterNeeds(args_, result_)), result_)
        }
      },
      {
        nondet counter = STRS.oneOf()
        nondet principal = STRS.oneOf()
        nondet id = IDS.oneOf()
        {
          val args_: RetireCounterArgs = { counter: counter, principal: principal }
          val result_ = retireCounterOutcome(log, args_)
          retireCounter(counter, id, principal, log.length(), triplesOf(retireCounterNeeds(args_, result_)), result_)
        }
      },
      {
        nondet counter = STRS.oneOf()
        showCounter(counter, log.length())
      },
      average(nextOf(log, checkpoints.get("average"), "counter-incremented")),
      welcomeSkip(nextOf(log, checkpoints.get("welcome"), "counter-created")),
      {
        nondet key_ = KEYS.oneOf()
        nondet ok_ = Bool.oneOf()
        welcomeEffect(nextOf(log, checkpoints.get("welcome"), "counter-created"), key_, ok_)
      },
      {
        nondet ok_ = Bool.oneOf()
        welcome(nextOf(log, checkpoints.get("welcome"), "counter-created"), ok_)
      },
      payoutSkip(nextOf(log, checkpoints.get("payout"), "counter-retired")),
      payout(nextOf(log, checkpoints.get("payout"), "counter-retired"), false),
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet ok_ = Bool.oneOf()
        payoutEffect(trigger_, key_, ok_)
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet ok_ = Bool.oneOf()
        nondet known_ = Bool.oneOf()
        payoutOutcome(trigger_, ok_, known_, "lost")
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "unknown").oneOf()
        {
          val req_: MailerSendRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "counter-created") welcomeMailerSend(log.slice(0, trigger_), trigger_) else { counter: "", name: "" }
          mailerSend("welcome", trigger_, key_, req_.counter, req_.name, result_)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok").oneOf()
        {
          val req_: MailerSendRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "counter-created") welcomeMailerSend(log.slice(0, trigger_), trigger_) else { counter: "", name: "" }
          mailerSendServed("welcome", trigger_, key_, req_.counter, req_.name, result_)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok").oneOf()
        {
          val req_: MailerSendRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "counter-created") welcomeMailerSend(log.slice(0, trigger_), trigger_) else { counter: "", name: "" }
          mailerSendReplayed("welcome", trigger_, key_, req_.counter, req_.name, result_)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "declined", "unknown").oneOf()
        nondet ref = STRS.oneOf()
        {
          val req_: BankPayRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "counter-retired") payoutBankPay(log.slice(0, trigger_), trigger_) else { counter: "", amount: 0 }
          bankPay("payout", trigger_, key_, req_.counter, req_.amount, result_, ref)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "declined").oneOf()
        nondet ref = STRS.oneOf()
        {
          val req_: BankPayRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "counter-retired") payoutBankPay(log.slice(0, trigger_), trigger_) else { counter: "", amount: 0 }
          bankPayServed("payout", trigger_, key_, req_.counter, req_.amount, result_, ref)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "declined").oneOf()
        nondet ref = STRS.oneOf()
        {
          val req_: BankPayRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "counter-retired") payoutBankPay(log.slice(0, trigger_), trigger_) else { counter: "", amount: 0 }
          bankPayReplayed("payout", trigger_, key_, req_.counter, req_.amount, result_, ref)
        }
      },
    }
  }
}

// The clients' side (counters.calls.binding.yaml): every call where a client
// saw it (actor <tenant>/clients), linearized by qtest.Linearize: no
// positions, no processors, the log the commands' events alone. A key's first
// answer is final here too; a call the API denied (403) answers nothing.
module countersCallsGen {
  import grist.* from "./grist"
  import countersEvents.*
  import countersRules.* from "./counters"
  export grist.*
  export countersEvents.*
  export countersRules.*

  var log: List[Event]
  var answered: Set[str]

  action init = all { log' = [], answered' = Set() }

  pure val IDS = Set("i1", "i2", "i3")

  action answers(b: List[Event], id: str): bool = all {
    freshKey(answered, id),
    log' = log.concat(b),
    answered' = answered.union(Set(id)),
  }

  // a call the API refused (403: the block's policy refused the actor) ran
  // nothing and answers nothing: its key stays unanswered
  action denied: bool = all { log' = log, answered' = answered }

  action createCounter(counter: str, name: str, id: str, principal: str, result: str): bool = {
    val args_: CreateCounterArgs = { counter: counter, name: name, principal: principal }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == createCounterOutcome(log, args_),
      answers(if (result == "ok") caused(createCounterEvents(log, args_), ("command", id)) else [], id),
    }
  }

  action incrementCounter(counter: str, by: int, id: str, principal: str, result: str): bool = {
    val args_: IncrementCounterArgs = { counter: counter, by: by, principal: principal }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == incrementCounterOutcome(log, args_),
      answers(if (result == "ok") caused(incrementCounterEvents(log, args_), ("command", id)) else [], id),
    }
  }

  action retireCounter(counter: str, id: str, principal: str, result: str): bool = {
    val args_: RetireCounterArgs = { counter: counter, principal: principal }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == retireCounterOutcome(log, args_),
      answers(if (result == "ok") caused(retireCounterEvents(log, args_), ("command", id)) else [], id),
    }
  }

  // show-counter changes nothing; its answer is showCounterAnswer's where it linearizes
  action showCounter(counter: str): bool = all { log' = log, answered' = answered }

  action step = {
    any {
      {
        nondet counter = STRS.oneOf()
        nondet name = STRS.oneOf()
        nondet principal = STRS.oneOf()
        nondet id = IDS.oneOf()
        createCounter(counter, name, id, principal, createCounterOutcome(log, { counter: counter, name: name, principal: principal }))
      },
      {
        nondet counter = STRS.oneOf()
        nondet by = INTS.oneOf()
        nondet principal = STRS.oneOf()
        nondet id = IDS.oneOf()
        incrementCounter(counter, by, id, principal, incrementCounterOutcome(log, { counter: counter, by: by, principal: principal }))
      },
      {
        nondet counter = STRS.oneOf()
        nondet principal = STRS.oneOf()
        nondet id = IDS.oneOf()
        retireCounter(counter, id, principal, retireCounterOutcome(log, { counter: counter, principal: principal }))
      },
      {
        nondet counter = STRS.oneOf()
        showCounter(counter)
      },
      all { log' = log, answered' = answered },
    }
  }
}
