// Generated by grist model from the inventory App's catalog (docs/grist.md §3.2):
// do not edit. Regenerate with the app's binary (`<app> model`, grist.Main)
// after changing a block; the application's rules are model/inventory_rules.qnt's,
// its invariants model/inventory.qnt's.

// The events, reads and argument records: what the rules (module inventoryRules)
// and the invariants are written with.
module inventoryEvents {
  import grist.* from "./grist"
  export grist.*

  // reserved (strs: its strings, ints: its integers and booleans, in field order)
  pure def reserved(order: str): Event =
    { typ: "reserved", strs: [order], ints: [], tags: Set(("order", order)), cause: UNCAUSED }
  pure def reservedOrder(e: Event): str = e.strs[0]
  pure val reservedRead: Read = { typ: "reserved", tags: Set() }
  pure def reservedByOrder(v: str): Read = { typ: "reserved", tags: Set(("order", v)) }

  // cancelled (strs: its strings, ints: its integers and booleans, in field order)
  pure def cancelled(order: str): Event =
    { typ: "cancelled", strs: [order], ints: [], tags: Set(("order", order)), cause: UNCAUSED }
  pure def cancelledOrder(e: Event): str = e.strs[0]
  pure val cancelledRead: Read = { typ: "cancelled", tags: Set() }
  pure def cancelledByOrder(v: str): Read = { typ: "cancelled", tags: Set(("order", v)) }

  // authorized (strs: its strings, ints: its integers and booleans, in field order)
  pure def authorized(order: str): Event =
    { typ: "authorized", strs: [order], ints: [], tags: Set(("order", order)), cause: UNCAUSED }
  pure def authorizedOrder(e: Event): str = e.strs[0]
  pure val authorizedRead: Read = { typ: "authorized", tags: Set() }
  pure def authorizedByOrder(v: str): Read = { typ: "authorized", tags: Set(("order", v)) }

  // read model allocations (keyed by order: the events of its types carrying
  // those tags): what it folds, and what a read of it records
  pure def allocationsEvents(log: List[Event], order: str): List[Event] = log.select(e => Set("reserved", "cancelled", "authorized").contains(e.typ) and e.tags.contains(("order", order)))
  pure def allocationsReads(order: str): Set[Read] = Set({ typ: "reserved", tags: Set(("order", order)) }, { typ: "cancelled", tags: Set(("order", order)) }, { typ: "authorized", tags: Set(("order", order)) })

  // read model stock (plain: every event of its types): what it folds, and
  // what a read of it records
  pure def stockEvents(log: List[Event]): List[Event] = log.select(e => Set("reserved", "cancelled").contains(e.typ))
  pure val stockReads: Set[Read] = Set({ typ: "reserved", tags: Set() }, { typ: "cancelled", tags: Set() })

  // each command's and query's arguments, with the caller that sent it
  type AuthorizeArgs = { order: str, caller: str }
  type CancelArgs = { order: str, caller: str }
  type ReserveArgs = { order: str, caller: str }
  // call fulfillment/start: its request and response, and a step of it (the caller's or the site's: the outcome as result,
  // the response zero unless it is ok)
  type FulfillmentStartRequest = { order: str }
  type FulfillmentStartResponse = { unit: bool }
  type FulfillmentStartRecord = { processor: str, trigger: int, key: str, request: FulfillmentStartRequest, result: str, response: FulfillmentStartResponse }
}
