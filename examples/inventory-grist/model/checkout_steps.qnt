// Generated by grist model from the checkout App's catalog (docs/grist.md §3.2):
// do not edit. Regenerate with the app's binary (`<app> model`, grist.Main)
// after changing a block; the application's rules are model/checkout_rules.qnt's,
// its invariants model/checkout.qnt's.

// The store's side (checkout.binding.yaml): every step where it took effect, one
// tenant's log. Commits are relayed from the store's step log, refusals
// recorded at their commit, queries on return, effects by their processors,
// sites by the dependencies that make them.
module checkoutGen {
  import grist.* from "./grist"
  import checkoutEvents.* from "./checkout_gen"
  import checkoutRules.* from "./checkout_rules"
  export grist.*
  export checkoutEvents.*
  export checkoutRules.*

  // one tenant's log
  var log: List[Event]
  // each processor's checkpoint: the last trigger it handled
  var checkpoints: str -> int
  // the batch the last step appended (what its observations are checked against)
  var appended: List[Event]
  // the effect steps: (processor, trigger, key, ok)
  var effects: List[Effect]
  // the command ids answered so far, by a commit or a committed refusal
  var answered: Set[str]
  // the log went backwards (gristRewound) and no operator has resumed the
  // processors since (gristResumed): they take no step
  var rewound: bool
  // the calls of inventory/reserve, a peer's command, as their callers saw them (Call.Do), in
  // order; the peer's model judges what it did
  var inventoryReserveCalls: List[InventoryReserveRecord]
  // the calls of inventory/cancel, a peer's command, as their callers saw them (Call.Do), in
  // order; the peer's model judges what it did
  var inventoryCancelCalls: List[InventoryCancelRecord]
  // the calls of inventory/authorize, a peer's command, as their callers saw them (Call.Do), in
  // order; the peer's model judges what it did
  var inventoryAuthorizeCalls: List[InventoryAuthorizeRecord]

  action init = all {
    log' = [],
    checkpoints' = Map("cancel-stock" -> 0, "reserve-stock" -> 0, "confirm-stock" -> 0),
    appended' = [],
    effects' = [],
    answered' = Set(),
    rewound' = false,
    inventoryReserveCalls' = [],
    inventoryCancelCalls' = [],
    inventoryAuthorizeCalls' = [],
  }

  // the identities, in the order commands take them, and the effect keys the
  // model on its own draws
  pure val IDS = ["i1", "i2", "i3", "i4", "i5", "i6", "i7", "i8", "i9", "i10", "i11", "i12", "i13", "i14", "i15", "i16", "i17", "i18", "i19", "i20", "i21", "i22", "i23", "i24", "i25", "i26", "i27", "i28", "i29", "i30"]
  pure val KEYS = Set("k1", "k2", "k3")
  // the next identity a command answers (none once all are): the first
  // unanswered, so that the model on its own never draws a used one (a
  // command that would be disabled) nor two that differ only by name
  pure def nextID(answered: Set[str]): Set[str] =
    IDS.foldl(Set(), (s, i) => if (s == Set() and not(answered.contains(i))) Set(i) else s)

  // a command's commit of b, answering id
  action appends(b: List[Event], id: str): bool = all {
    log' = log.concat(b),
    checkpoints' = checkpoints,
    appended' = b,
    effects' = effects,
    answered' = answered.union(Set(id)),
    rewound' = rewound,
    inventoryReserveCalls' = inventoryReserveCalls,
    inventoryCancelCalls' = inventoryCancelCalls,
    inventoryAuthorizeCalls' = inventoryAuthorizeCalls,
  }

  // a committed refusal: its marker answers id, nothing is appended; it
  // commits at the head, at or after the position it read through
  action refuses(readPos: int, id: str): bool = all {
    readPos <= log.length(),
    appends([], id),
  }

  // a step that commits nothing (a query, a reused key): it read through
  // readPos, the log's length where it is ordered (2·readPos+1)
  action readsThrough(readPos: int): bool = all {
    log.length() == readPos,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    rewound' = rewound,
    inventoryReserveCalls' = inventoryReserveCalls,
    inventoryCancelCalls' = inventoryCancelCalls,
    inventoryAuthorizeCalls' = inventoryAuthorizeCalls,
  }

  // a processor's handling of trigger, appending b with its checkpoint
  action processes(b: List[Event], p: str, trigger: int): bool = all {
    not(rewound),
    log' = log.concat(b),
    checkpoints' = checkpoints.set(p, trigger),
    appended' = b,
    effects' = effects,
    answered' = answered,
    rewound' = rewound,
    inventoryReserveCalls' = inventoryReserveCalls,
    inventoryCancelCalls' = inventoryCancelCalls,
    inventoryAuthorizeCalls' = inventoryAuthorizeCalls,
  }

  // an effect step of processor p for trigger, under key (the same on every
  // effect step of the trigger, no other trigger's: keyStable)
  action effectStep(p: str, trigger: int, key: str, ok: bool): bool = all {
    not(rewound),
    keyStable(effects, p, trigger, key),
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects.append((p, trigger, key, ok)),
    answered' = answered,
    rewound' = rewound,
    inventoryReserveCalls' = inventoryReserveCalls,
    inventoryCancelCalls' = inventoryCancelCalls,
    inventoryAuthorizeCalls' = inventoryAuthorizeCalls,
  }

  // the log went backwards (grist.ErrRewound: a failover lost its tail, a
  // restore put a backup back), as a node's relay saw it: back to position
  // pos, each processor's checkpoint there cps, the ids answered after it lost. The
  // processors stop until an operator resumes them (gristResumed); what the
  // dependencies and the effects did stays done
  action gristRewound(pos: int, cps: str -> int, lost: Set[str]): bool = all {
    pos <= log.length(),
    cps.keys() == checkpoints.keys(),
    log' = log.slice(0, pos),
    checkpoints' = cps,
    appended' = [],
    effects' = effects,
    answered' = answered.exclude(lost),
    rewound' = true,
    inventoryReserveCalls' = inventoryReserveCalls,
    inventoryCancelCalls' = inventoryCancelCalls,
    inventoryAuthorizeCalls' = inventoryAuthorizeCalls,
  }

  // an operator's resume (`<app> resume`): the processors go on from their
  // checkpoints, and the effect steps and calls of the triggers after them
  // are forgotten: those triggers are handled again (at least once, under
  // the same key, or a key of its own where the position was given back
  // and filled by another event; at most once, again: the operator's
  // decision). What the dependencies applied stays (their records)
  action gristResumed: bool = all {
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects.select(e => e._2 <= checkpoints.get(e._1)),
    answered' = answered,
    rewound' = false,
    inventoryReserveCalls' = inventoryReserveCalls.select(c => c.trigger <= checkpoints.get(c.processor)),
    inventoryCancelCalls' = inventoryCancelCalls.select(c => c.trigger <= checkpoints.get(c.processor)),
    inventoryAuthorizeCalls' = inventoryAuthorizeCalls.select(c => c.trigger <= checkpoints.get(c.processor)),
  }

  // cancel: conditioned on its reads; refusals unknown-order, duplicate.
  // Every committed outcome needs its id fresh and its read set covering what
  // its rule needs; ok and a refusal need the rule's outcome and the
  // condition to have held, a conflict needs it not to. A reused key commits
  // nothing.
  action cancel(order: str, id: str, caller: str, readPos: int, reads: Set[(str, str, str)], result: str): bool = {
    val args_: CancelArgs = { order: order, caller: caller }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      cancelNeeds(args_, result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == cancelOutcome(log, args_),
        if (result == "ok") appends(caused(cancelEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // confirm: conditioned on its reads; refusals unknown-order, duplicate.
  // Every committed outcome needs its id fresh and its read set covering what
  // its rule needs; ok and a refusal need the rule's outcome and the
  // condition to have held, a conflict needs it not to. A reused key commits
  // nothing.
  action confirm(order: str, id: str, caller: str, readPos: int, reads: Set[(str, str, str)], result: str): bool = {
    val args_: ConfirmArgs = { order: order, caller: caller }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      confirmNeeds(args_, result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == confirmOutcome(log, args_),
        if (result == "ok") appends(caused(confirmEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // place: conditioned on its reads; refusals duplicate. Every committed
  // outcome needs its id fresh and its read set covering what its rule needs;
  // ok and a refusal need the rule's outcome and the condition to have held,
  // a conflict needs it not to. A reused key commits nothing.
  action place(order: str, id: str, caller: str, readPos: int, reads: Set[(str, str, str)], result: str): bool = {
    val args_: PlaceArgs = { order: order, caller: caller }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      placeNeeds(args_, result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == placeOutcome(log, args_),
        if (result == "ok") appends(caused(placeEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // cancel-stock skips a trigger its rule says it skips (cancelStockSkips: the handler's Skip),
  // its checkpoint alone, no effect step; a handler's Fail is recorded so
  // too, appending grist.failed, which a skip's empty batch does not match
  action cancelStockSkip(trigger: int): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("cancel-stock"), "cancellation-requested"),
    cancelStockSkips(log.slice(0, trigger), trigger),
    triesOf(effects, "cancel-stock", trigger) == 0,
    processes([], "cancel-stock", trigger),
  }

  // cancel-stock's effect, at least once: any number of tries for its next trigger
  // before its checkpoint, every one under the trigger's key
  action cancelStockEffect(trigger: int, key: str, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("cancel-stock"), "cancellation-requested"),
    not(cancelStockSkips(log.slice(0, trigger), trigger)),
    effectStep("cancel-stock", trigger, key, ok),
  }

  // cancel-stock's checkpoint, only after effect steps: its success after an ok one,
  // grist.failed after 3 failed ones, whichever the run committed (ok: its
  // record of which)
  action cancelStock(trigger: int, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("cancel-stock"), "cancellation-requested"),
    atLeastOnceDone(effects, "cancel-stock", trigger, ok, 3),
    processes(atLeastOnceOutcome("cancel-stock", trigger, ok, []), "cancel-stock", trigger),
  }

  // cancel-stock is at least once: its outcome commits with its checkpoint, never
  // alone, so an outcome step of its own is no step of this model
  action cancelStockOutcome(trigger: int, ok: bool): bool = all {
    false,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    rewound' = rewound,
    inventoryReserveCalls' = inventoryReserveCalls,
    inventoryCancelCalls' = inventoryCancelCalls,
    inventoryAuthorizeCalls' = inventoryAuthorizeCalls,
  }

  // reserve-stock skips a trigger its rule says it skips (reserveStockSkips: the handler's Skip),
  // its checkpoint alone, no effect step; a handler's Fail is recorded so
  // too, appending grist.failed, which a skip's empty batch does not match
  action reserveStockSkip(trigger: int): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("reserve-stock"), "placed"),
    reserveStockSkips(log.slice(0, trigger), trigger),
    triesOf(effects, "reserve-stock", trigger) == 0,
    processes([], "reserve-stock", trigger),
  }

  // reserve-stock's effect, at least once: any number of tries for its next trigger
  // before its checkpoint, every one under the trigger's key
  action reserveStockEffect(trigger: int, key: str, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("reserve-stock"), "placed"),
    not(reserveStockSkips(log.slice(0, trigger), trigger)),
    effectStep("reserve-stock", trigger, key, ok),
  }

  // reserve-stock's checkpoint, only after effect steps: its success after an ok one,
  // grist.failed after 3 failed ones, whichever the run committed (ok: its
  // record of which)
  action reserveStock(trigger: int, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("reserve-stock"), "placed"),
    atLeastOnceDone(effects, "reserve-stock", trigger, ok, 3),
    processes(atLeastOnceOutcome("reserve-stock", trigger, ok, []), "reserve-stock", trigger),
  }

  // reserve-stock is at least once: its outcome commits with its checkpoint, never
  // alone, so an outcome step of its own is no step of this model
  action reserveStockOutcome(trigger: int, ok: bool): bool = all {
    false,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    rewound' = rewound,
    inventoryReserveCalls' = inventoryReserveCalls,
    inventoryCancelCalls' = inventoryCancelCalls,
    inventoryAuthorizeCalls' = inventoryAuthorizeCalls,
  }

  // confirm-stock skips a trigger its rule says it skips (confirmStockSkips: the handler's Skip),
  // its checkpoint alone, no effect step; a handler's Fail is recorded so
  // too, appending grist.failed, which a skip's empty batch does not match
  action confirmStockSkip(trigger: int): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("confirm-stock"), "confirmation-requested"),
    confirmStockSkips(log.slice(0, trigger), trigger),
    triesOf(effects, "confirm-stock", trigger) == 0,
    processes([], "confirm-stock", trigger),
  }

  // confirm-stock's effect, at least once: any number of tries for its next trigger
  // before its checkpoint, every one under the trigger's key
  action confirmStockEffect(trigger: int, key: str, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("confirm-stock"), "confirmation-requested"),
    not(confirmStockSkips(log.slice(0, trigger), trigger)),
    effectStep("confirm-stock", trigger, key, ok),
  }

  // confirm-stock's checkpoint, only after effect steps: its success after an ok one,
  // grist.failed after 3 failed ones, whichever the run committed (ok: its
  // record of which)
  action confirmStock(trigger: int, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("confirm-stock"), "confirmation-requested"),
    atLeastOnceDone(effects, "confirm-stock", trigger, ok, 3),
    processes(atLeastOnceOutcome("confirm-stock", trigger, ok, []), "confirm-stock", trigger),
  }

  // confirm-stock is at least once: its outcome commits with its checkpoint, never
  // alone, so an outcome step of its own is no step of this model
  action confirmStockOutcome(trigger: int, ok: bool): bool = all {
    false,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    rewound' = rewound,
    inventoryReserveCalls' = inventoryReserveCalls,
    inventoryCancelCalls' = inventoryCancelCalls,
    inventoryAuthorizeCalls' = inventoryAuthorizeCalls,
  }

  // the keys of inventory/reserve's steps: (processor, trigger, key)
  pure def inventoryReserveKeys(l: List[InventoryReserveRecord]): List[CallKey] = l.foldl([], (acc, c) => acc.append((c.processor, c.trigger, c.key)))

  // inventory/reserve as its caller saw it (Call.Do: invoked before the
  // request, done with the answer, the outcome ok, a declared refusal or
  // unknown): from an effect of a processor that uses it, for one of its
  // triggers before the effect step, under the trigger's key (callKeyStable),
  // its request the processor's rule's
  action inventoryReserve(processor: str, trigger: int, key: str, order: str, result: str): bool = {
    val rec_: InventoryReserveRecord = { processor: processor, trigger: trigger, key: key, request: { order: order }, result: result, response: { unit: true } }
    all {
      or {
        processor == "reserve-stock" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "placed",
          rec_.request == reserveStockInventoryReserve(log.slice(0, trigger), trigger),
          not(reserveStockSkips(log.slice(0, trigger), trigger)),
          trigger == nextOf(log, checkpoints.get("reserve-stock"), "placed"),
        } else false),
      },
      callKeyStable(effects, inventoryReserveKeys(inventoryReserveCalls), processor, trigger, key),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      rewound' = rewound,
      inventoryReserveCalls' = inventoryReserveCalls.append(rec_),
      inventoryCancelCalls' = inventoryCancelCalls,
      inventoryAuthorizeCalls' = inventoryAuthorizeCalls,
    }
  }

  // the keys of inventory/cancel's steps: (processor, trigger, key)
  pure def inventoryCancelKeys(l: List[InventoryCancelRecord]): List[CallKey] = l.foldl([], (acc, c) => acc.append((c.processor, c.trigger, c.key)))

  // inventory/cancel as its caller saw it (Call.Do: invoked before the
  // request, done with the answer, the outcome ok, a declared refusal or
  // unknown): from an effect of a processor that uses it, for one of its
  // triggers before the effect step, under the trigger's key (callKeyStable),
  // its request the processor's rule's
  action inventoryCancel(processor: str, trigger: int, key: str, order: str, result: str): bool = {
    val rec_: InventoryCancelRecord = { processor: processor, trigger: trigger, key: key, request: { order: order }, result: result, response: { unit: true } }
    all {
      or {
        processor == "cancel-stock" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "cancellation-requested",
          rec_.request == cancelStockInventoryCancel(log.slice(0, trigger), trigger),
          not(cancelStockSkips(log.slice(0, trigger), trigger)),
          trigger == nextOf(log, checkpoints.get("cancel-stock"), "cancellation-requested"),
        } else false),
      },
      callKeyStable(effects, inventoryCancelKeys(inventoryCancelCalls), processor, trigger, key),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      rewound' = rewound,
      inventoryReserveCalls' = inventoryReserveCalls,
      inventoryCancelCalls' = inventoryCancelCalls.append(rec_),
      inventoryAuthorizeCalls' = inventoryAuthorizeCalls,
    }
  }

  // the keys of inventory/authorize's steps: (processor, trigger, key)
  pure def inventoryAuthorizeKeys(l: List[InventoryAuthorizeRecord]): List[CallKey] = l.foldl([], (acc, c) => acc.append((c.processor, c.trigger, c.key)))

  // inventory/authorize as its caller saw it (Call.Do: invoked before the
  // request, done with the answer, the outcome ok, a declared refusal or
  // unknown): from an effect of a processor that uses it, for one of its
  // triggers before the effect step, under the trigger's key (callKeyStable),
  // its request the processor's rule's
  action inventoryAuthorize(processor: str, trigger: int, key: str, order: str, result: str): bool = {
    val rec_: InventoryAuthorizeRecord = { processor: processor, trigger: trigger, key: key, request: { order: order }, result: result, response: { unit: true } }
    all {
      or {
        processor == "confirm-stock" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "confirmation-requested",
          rec_.request == confirmStockInventoryAuthorize(log.slice(0, trigger), trigger),
          not(confirmStockSkips(log.slice(0, trigger), trigger)),
          trigger == nextOf(log, checkpoints.get("confirm-stock"), "confirmation-requested"),
        } else false),
      },
      callKeyStable(effects, inventoryAuthorizeKeys(inventoryAuthorizeCalls), processor, trigger, key),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      rewound' = rewound,
      inventoryReserveCalls' = inventoryReserveCalls,
      inventoryCancelCalls' = inventoryCancelCalls,
      inventoryAuthorizeCalls' = inventoryAuthorizeCalls.append(rec_),
    }
  }

  // The obligations the catalog implies (docs/grist.md §3.3.1): eventual
  // vals, judged by the store's bindings at a settle beside the app's own
  // (the default binding's, and a variant's that judges every invariant of
  // the default binding, a call's where it judges the call's served records)

  // after a settle, cancel-stock (at least once) has handled every
  // cancellation-requested: its checkpoint passed it, and it was skipped
  // (cancelStockSkips), had an ok effect step, or failed every try (its
  // grist.failed)
  val cancelStockEventuallyHandled =
    log.indices().forall(i => log[i].typ == "cancellation-requested" implies and {
      checkpoints.get("cancel-stock") >= i + 1,
      or {
        cancelStockSkips(log.slice(0, i + 1), i + 1),
        effectsOf(effects, "cancel-stock", i + 1, true) > 0,
        holds(log, failed("cancel-stock", i + 1)),
      },
    })

  // after a settle, reserve-stock (at least once) has handled every placed:
  // its checkpoint passed it, and it was skipped (reserveStockSkips), had an
  // ok effect step, or failed every try (its grist.failed)
  val reserveStockEventuallyHandled =
    log.indices().forall(i => log[i].typ == "placed" implies and {
      checkpoints.get("reserve-stock") >= i + 1,
      or {
        reserveStockSkips(log.slice(0, i + 1), i + 1),
        effectsOf(effects, "reserve-stock", i + 1, true) > 0,
        holds(log, failed("reserve-stock", i + 1)),
      },
    })

  // after a settle, confirm-stock (at least once) has handled every
  // confirmation-requested: its checkpoint passed it, and it was skipped
  // (confirmStockSkips), had an ok effect step, or failed every try (its
  // grist.failed)
  val confirmStockEventuallyHandled =
    log.indices().forall(i => log[i].typ == "confirmation-requested" implies and {
      checkpoints.get("confirm-stock") >= i + 1,
      or {
        confirmStockSkips(log.slice(0, i + 1), i + 1),
        effectsOf(effects, "confirm-stock", i + 1, true) > 0,
        holds(log, failed("confirm-stock", i + 1)),
      },
    })

  // the model on its own (gotogether simulate): every command as its rule
  // decides, reading what it needs, every query, processor and site, each
  // drawing its own arguments (one draw shared by every block would make
  // the step's successors the product of all their domains)
  action step = {
    any {
      {
        nondet order = STRS.oneOf()
        nondet caller = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        {
          val args_: CancelArgs = { order: order, caller: caller }
          val result_ = cancelOutcome(log, args_)
          cancel(order, id, caller, log.length(), triplesOf(cancelNeeds(args_, result_)), result_)
        }
      },
      {
        nondet order = STRS.oneOf()
        nondet caller = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        {
          val args_: ConfirmArgs = { order: order, caller: caller }
          val result_ = confirmOutcome(log, args_)
          confirm(order, id, caller, log.length(), triplesOf(confirmNeeds(args_, result_)), result_)
        }
      },
      {
        nondet order = STRS.oneOf()
        nondet caller = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        {
          val args_: PlaceArgs = { order: order, caller: caller }
          val result_ = placeOutcome(log, args_)
          place(order, id, caller, log.length(), triplesOf(placeNeeds(args_, result_)), result_)
        }
      },
      cancelStockSkip(nextOf(log, checkpoints.get("cancel-stock"), "cancellation-requested")),
      {
        nondet key_ = KEYS.oneOf()
        nondet ok_ = Bool.oneOf()
        cancelStockEffect(nextOf(log, checkpoints.get("cancel-stock"), "cancellation-requested"), key_, ok_)
      },
      {
        nondet ok_ = Bool.oneOf()
        cancelStock(nextOf(log, checkpoints.get("cancel-stock"), "cancellation-requested"), ok_)
      },
      reserveStockSkip(nextOf(log, checkpoints.get("reserve-stock"), "placed")),
      {
        nondet key_ = KEYS.oneOf()
        nondet ok_ = Bool.oneOf()
        reserveStockEffect(nextOf(log, checkpoints.get("reserve-stock"), "placed"), key_, ok_)
      },
      {
        nondet ok_ = Bool.oneOf()
        reserveStock(nextOf(log, checkpoints.get("reserve-stock"), "placed"), ok_)
      },
      confirmStockSkip(nextOf(log, checkpoints.get("confirm-stock"), "confirmation-requested")),
      {
        nondet key_ = KEYS.oneOf()
        nondet ok_ = Bool.oneOf()
        confirmStockEffect(nextOf(log, checkpoints.get("confirm-stock"), "confirmation-requested"), key_, ok_)
      },
      {
        nondet ok_ = Bool.oneOf()
        confirmStock(nextOf(log, checkpoints.get("confirm-stock"), "confirmation-requested"), ok_)
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "cancelled", "too-late", "full", "unknown").oneOf()
        {
          val req_: InventoryReserveRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "placed") reserveStockInventoryReserve(log.slice(0, trigger_), trigger_) else { order: "" }
          inventoryReserve("reserve-stock", trigger_, key_, req_.order, result_)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "too-late", "unknown").oneOf()
        {
          val req_: InventoryCancelRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "cancellation-requested") cancelStockInventoryCancel(log.slice(0, trigger_), trigger_) else { order: "" }
          inventoryCancel("cancel-stock", trigger_, key_, req_.order, result_)
        }
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "not-held", "unknown").oneOf()
        {
          val req_: InventoryAuthorizeRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "confirmation-requested") confirmStockInventoryAuthorize(log.slice(0, trigger_), trigger_) else { order: "" }
          inventoryAuthorize("confirm-stock", trigger_, key_, req_.order, result_)
        }
      },
    }
  }
}

// The clients' side (checkout.calls.binding.yaml): every call where a client
// saw it (actor <app>/<tenant>/clients), linearized by qtest.Linearize: no
// positions, no processors, the log the commands' events alone. A key's first
// answer is final here too; a call the API denied (403) answers nothing.
module checkoutCallsGen {
  import grist.* from "./grist"
  import checkoutEvents.* from "./checkout_gen"
  import checkoutRules.* from "./checkout_rules"
  export grist.*
  export checkoutEvents.*
  export checkoutRules.*

  var log: List[Event]
  var answered: Set[str]

  action init = all { log' = [], answered' = Set() }

  pure val IDS = ["i1", "i2", "i3", "i4", "i5", "i6", "i7", "i8", "i9", "i10", "i11", "i12", "i13", "i14", "i15", "i16", "i17", "i18", "i19", "i20", "i21", "i22", "i23", "i24", "i25", "i26", "i27", "i28", "i29", "i30"]
  // the next identity a command answers (none once all are): the first
  // unanswered, so that the model on its own never draws a used one (a
  // command that would be disabled) nor two that differ only by name
  pure def nextID(answered: Set[str]): Set[str] =
    IDS.foldl(Set(), (s, i) => if (s == Set() and not(answered.contains(i))) Set(i) else s)

  action answers(b: List[Event], id: str): bool = all {
    freshKey(answered, id),
    log' = log.concat(b),
    answered' = answered.union(Set(id)),
  }

  // a call the API refused (403: the block's policy refused the caller) ran
  // nothing and answers nothing: its key stays unanswered
  action denied: bool = all { log' = log, answered' = answered }

  action cancel(order: str, id: str, caller: str, result: str): bool = {
    val args_: CancelArgs = { order: order, caller: caller }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == cancelOutcome(log, args_),
      answers(if (result == "ok") caused(cancelEvents(log, args_), ("command", id)) else [], id),
    }
  }

  action confirm(order: str, id: str, caller: str, result: str): bool = {
    val args_: ConfirmArgs = { order: order, caller: caller }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == confirmOutcome(log, args_),
      answers(if (result == "ok") caused(confirmEvents(log, args_), ("command", id)) else [], id),
    }
  }

  action place(order: str, id: str, caller: str, result: str): bool = {
    val args_: PlaceArgs = { order: order, caller: caller }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == placeOutcome(log, args_),
      answers(if (result == "ok") caused(placeEvents(log, args_), ("command", id)) else [], id),
    }
  }

  action step = {
    any {
      {
        nondet order = STRS.oneOf()
        nondet caller = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        cancel(order, id, caller, cancelOutcome(log, { order: order, caller: caller }))
      },
      {
        nondet order = STRS.oneOf()
        nondet caller = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        confirm(order, id, caller, confirmOutcome(log, { order: order, caller: caller }))
      },
      {
        nondet order = STRS.oneOf()
        nondet caller = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        place(order, id, caller, placeOutcome(log, { order: order, caller: caller }))
      },
      all { log' = log, answered' = answered },
    }
  }
}
