// Generated by grist model from the payouts App's catalog (docs/grist.md §3.2):
// do not edit. Regenerate with the app's binary (`<app> model`, grist.Main)
// after changing a block; the application's rules are model/payouts_rules.qnt's,
// its invariants model/payouts.qnt's.

// The store's side (payouts.binding.yaml): every step where it took effect, one
// tenant's log. Commits are relayed from the store's step log, refusals
// recorded at their commit, queries on return, effects by their processors,
// sites by the dependencies that make them.
module payoutsGen {
  import grist.* from "./grist"
  import payoutsEvents.* from "./payouts_gen"
  import payoutsRules.* from "./payouts_rules"
  export grist.*
  export payoutsEvents.*
  export payoutsRules.*

  // one tenant's log
  var log: List[Event]
  // each processor's checkpoint: the last trigger it handled
  var checkpoints: str -> int
  // the batch the last step appended (what its observations are checked against)
  var appended: List[Event]
  // the effect steps: (processor, trigger, key, ok)
  var effects: List[Effect]
  // the command ids answered so far, by a commit or a committed refusal
  var answered: Set[str]
  // the log went backwards (gristRewound) and no operator has resumed the
  // processors since (gristResumed): they take no step
  var rewound: bool
  // the calls of bank/pay, a peer's command, as their callers saw them (Call.Do), in
  // order; the peer's model judges what it did
  var bankPayCalls: List[BankPayRecord]

  action init = all {
    log' = [],
    checkpoints' = Map("send" -> 0),
    appended' = [],
    effects' = [],
    answered' = Set(),
    rewound' = false,
    bankPayCalls' = [],
  }

  // the identities, in the order commands take them, and the effect keys the
  // model on its own draws
  pure val IDS = ["i1", "i2", "i3", "i4", "i5", "i6", "i7", "i8", "i9", "i10", "i11", "i12", "i13", "i14", "i15", "i16", "i17", "i18", "i19", "i20", "i21", "i22", "i23", "i24", "i25", "i26", "i27", "i28", "i29", "i30"]
  pure val KEYS = Set("k1", "k2", "k3")
  // the next identity a command answers (none once all are): the first
  // unanswered, so that the model on its own never draws a used one (a
  // command that would be disabled) nor two that differ only by name
  pure def nextID(answered: Set[str]): Set[str] =
    IDS.foldl(Set(), (s, i) => if (s == Set() and not(answered.contains(i))) Set(i) else s)

  // a command's commit of b, answering id
  action appends(b: List[Event], id: str): bool = all {
    log' = log.concat(b),
    checkpoints' = checkpoints,
    appended' = b,
    effects' = effects,
    answered' = answered.union(Set(id)),
    rewound' = rewound,
    bankPayCalls' = bankPayCalls,
  }

  // a committed refusal: its marker answers id, nothing is appended; it
  // commits at the head, at or after the position it read through
  action refuses(readPos: int, id: str): bool = all {
    readPos <= log.length(),
    appends([], id),
  }

  // a step that commits nothing (a query, a reused key): it read through
  // readPos, the log's length where it is ordered (2·readPos+1)
  action readsThrough(readPos: int): bool = all {
    log.length() == readPos,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    rewound' = rewound,
    bankPayCalls' = bankPayCalls,
  }

  // a processor's handling of trigger, appending b with its checkpoint
  action processes(b: List[Event], p: str, trigger: int): bool = all {
    not(rewound),
    log' = log.concat(b),
    checkpoints' = checkpoints.set(p, trigger),
    appended' = b,
    effects' = effects,
    answered' = answered,
    rewound' = rewound,
    bankPayCalls' = bankPayCalls,
  }

  // an effect step of processor p for trigger, under key (the same on every
  // effect step of the trigger, no other trigger's: keyStable)
  action effectStep(p: str, trigger: int, key: str, ok: bool): bool = all {
    not(rewound),
    keyStable(effects, p, trigger, key),
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects.append((p, trigger, key, ok)),
    answered' = answered,
    rewound' = rewound,
    bankPayCalls' = bankPayCalls,
  }

  // the log went backwards (grist.ErrRewound: a failover lost its tail, a
  // restore put a backup back), as a node's relay saw it: back to position
  // pos, each processor's checkpoint there cps, the ids answered after it lost. The
  // processors stop until an operator resumes them (gristResumed); what the
  // dependencies and the effects did stays done
  action gristRewound(pos: int, cps: str -> int, lost: Set[str]): bool = all {
    pos <= log.length(),
    cps.keys() == checkpoints.keys(),
    log' = log.slice(0, pos),
    checkpoints' = cps,
    appended' = [],
    effects' = effects,
    answered' = answered.exclude(lost),
    rewound' = true,
    bankPayCalls' = bankPayCalls,
  }

  // an operator's resume (`<app> resume`): the processors go on from their
  // checkpoints, and the effect steps and calls of the triggers after them
  // are forgotten: those triggers are handled again (at least once, under
  // the same key, or a key of its own where the position was given back
  // and filled by another event; at most once, again: the operator's
  // decision). What the dependencies applied stays (their records)
  action gristResumed: bool = all {
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects.select(e => e._2 <= checkpoints.get(e._1)),
    answered' = answered,
    rewound' = false,
    bankPayCalls' = bankPayCalls.select(c => c.trigger <= checkpoints.get(c.processor)),
  }

  // request: conditioned on its reads; refusals duplicate, invalid. Every
  // committed outcome needs its id fresh and its read set covering what its
  // rule needs; ok and a refusal need the rule's outcome and the condition to
  // have held, a conflict needs it not to. A reused key commits nothing.
  action request(payout: str, account: str, amount: int, id: str, caller: str, readPos: int, reads: Set[(str, str, str)], result: str): bool = {
    val args_: RequestArgs = { payout: payout, account: account, amount: amount, caller: caller }
    val reads_ = readsOf(reads)
    if (result == "idempotency-key-reused") all { answered.contains(id), readsThrough(readPos) }
    else all {
      freshKey(answered, id),
      requestNeeds(args_, result).forall(n => covers(reads_, n)),
      if (result == "conflict") all { not(conditionHolds(log, readPos, reads_)), refuses(readPos, id) }
      else all {
        conditionHolds(log, readPos, reads_),
        result == requestOutcome(log, args_),
        if (result == "ok") appends(caused(requestEvents(log, args_), ("command", id)), id)
        else refuses(readPos, id),
      },
    }
  }

  // send's success event for trigger, caused by it (sendSuccess's)
  pure def sendSucceeded(log: List[Event], trigger: int): List[Event] =
    caused(sendSuccess(log.slice(0, trigger), trigger), ("processor", "send"))

  // send skips a trigger its rule says it skips (sendSkips: the handler's Skip),
  // its checkpoint alone, no effect step; a handler's Fail is recorded so
  // too, appending grist.failed, which a skip's empty batch does not match
  action sendSkip(trigger: int): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("send"), "requested"),
    sendSkips(log.slice(0, trigger), trigger),
    triesOf(effects, "send", trigger) == 0,
    processes([], "send", trigger),
  }

  // send's effect, at least once: any number of tries for its next trigger
  // before its checkpoint, every one under the trigger's key
  action sendEffect(trigger: int, key: str, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("send"), "requested"),
    not(sendSkips(log.slice(0, trigger), trigger)),
    effectStep("send", trigger, key, ok),
  }

  // send's checkpoint, only after effect steps: its success after an ok one,
  // grist.failed after 3 failed ones, whichever the run committed (ok: its
  // record of which)
  action send(trigger: int, ok: bool): bool = all {
    trigger > 0,
    trigger == nextOf(log, checkpoints.get("send"), "requested"),
    atLeastOnceDone(effects, "send", trigger, ok, 3),
    processes(atLeastOnceOutcome("send", trigger, ok, sendSucceeded(log, trigger)), "send", trigger),
  }

  // send is at least once: its outcome commits with its checkpoint, never
  // alone, so an outcome step of its own is no step of this model
  action sendOutcome(trigger: int, ok: bool): bool = all {
    false,
    log' = log,
    checkpoints' = checkpoints,
    appended' = [],
    effects' = effects,
    answered' = answered,
    rewound' = rewound,
    bankPayCalls' = bankPayCalls,
  }

  // the keys of bank/pay's steps: (processor, trigger, key)
  pure def bankPayKeys(l: List[BankPayRecord]): List[CallKey] = l.foldl([], (acc, c) => acc.append((c.processor, c.trigger, c.key)))

  // bank/pay as its caller saw it (Call.Do: invoked before the request, done
  // with the answer, the outcome ok, a declared refusal or unknown): from an
  // effect of a processor that uses it, for one of its triggers before the
  // effect step, under the trigger's key (callKeyStable), its request the
  // processor's rule's
  action bankPay(processor: str, trigger: int, key: str, account: str, amount: int, payout: str, result: str): bool = {
    val rec_: BankPayRecord = { processor: processor, trigger: trigger, key: key, request: { account: account, amount: amount, payout: payout }, result: result, response: { unit: true } }
    all {
      or {
        processor == "send" and (if (trigger > 0 and trigger <= log.length()) and {
          log[trigger - 1].typ == "requested",
          rec_.request == sendBankPay(log.slice(0, trigger), trigger),
          not(sendSkips(log.slice(0, trigger), trigger)),
          trigger == nextOf(log, checkpoints.get("send"), "requested"),
        } else false),
      },
      callKeyStable(effects, bankPayKeys(bankPayCalls), processor, trigger, key),
      log' = log,
      checkpoints' = checkpoints,
      appended' = [],
      effects' = effects,
      answered' = answered,
      rewound' = rewound,
      bankPayCalls' = bankPayCalls.append(rec_),
    }
  }

  // The obligations the catalog implies (docs/grist.md §3.3.1): eventual
  // vals, judged by the store's bindings at a settle beside the app's own
  // (the default binding's, and a variant's that judges every invariant of
  // the default binding, a call's where it judges the call's served records)

  // after a settle, send (at least once) has handled every requested: its
  // checkpoint passed it, and it was skipped (sendSkips), had an ok effect
  // step, or failed every try (its grist.failed)
  val sendEventuallyHandled =
    log.indices().forall(i => log[i].typ == "requested" implies and {
      checkpoints.get("send") >= i + 1,
      or {
        sendSkips(log.slice(0, i + 1), i + 1),
        effectsOf(effects, "send", i + 1, true) > 0,
        holds(log, failed("send", i + 1)),
      },
    })

  // the model on its own (gotogether simulate): every command as its rule
  // decides, reading what it needs, every query, processor and site, each
  // drawing its own arguments (one draw shared by every block would make
  // the step's successors the product of all their domains)
  action step = {
    any {
      {
        nondet payout = STRS.oneOf()
        nondet account = STRS.oneOf()
        nondet amount = INTS.oneOf()
        nondet caller = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        {
          val args_: RequestArgs = { payout: payout, account: account, amount: amount, caller: caller }
          val result_ = requestOutcome(log, args_)
          request(payout, account, amount, id, caller, log.length(), triplesOf(requestNeeds(args_, result_)), result_)
        }
      },
      sendSkip(nextOf(log, checkpoints.get("send"), "requested")),
      {
        nondet key_ = KEYS.oneOf()
        nondet ok_ = Bool.oneOf()
        sendEffect(nextOf(log, checkpoints.get("send"), "requested"), key_, ok_)
      },
      {
        nondet ok_ = Bool.oneOf()
        send(nextOf(log, checkpoints.get("send"), "requested"), ok_)
      },
      {
        nondet trigger_ = 1.to(log.length() + 1).oneOf()
        nondet key_ = KEYS.oneOf()
        nondet result_ = Set("ok", "unknown-account", "unknown").oneOf()
        {
          val req_: BankPayRequest = if (trigger_ <= log.length() and log[trigger_ - 1].typ == "requested") sendBankPay(log.slice(0, trigger_), trigger_) else { account: "", amount: 0, payout: "" }
          bankPay("send", trigger_, key_, req_.account, req_.amount, req_.payout, result_)
        }
      },
    }
  }
}

// The clients' side (payouts.calls.binding.yaml): every call where a client
// saw it (actor <app>/<tenant>/clients), linearized by qtest.Linearize: no
// positions, no processors, the log the commands' events alone. A key's first
// answer is final here too; a call the API denied (403) answers nothing.
module payoutsCallsGen {
  import grist.* from "./grist"
  import payoutsEvents.* from "./payouts_gen"
  import payoutsRules.* from "./payouts_rules"
  export grist.*
  export payoutsEvents.*
  export payoutsRules.*

  var log: List[Event]
  var answered: Set[str]

  action init = all { log' = [], answered' = Set() }

  pure val IDS = ["i1", "i2", "i3", "i4", "i5", "i6", "i7", "i8", "i9", "i10", "i11", "i12", "i13", "i14", "i15", "i16", "i17", "i18", "i19", "i20", "i21", "i22", "i23", "i24", "i25", "i26", "i27", "i28", "i29", "i30"]
  // the next identity a command answers (none once all are): the first
  // unanswered, so that the model on its own never draws a used one (a
  // command that would be disabled) nor two that differ only by name
  pure def nextID(answered: Set[str]): Set[str] =
    IDS.foldl(Set(), (s, i) => if (s == Set() and not(answered.contains(i))) Set(i) else s)

  action answers(b: List[Event], id: str): bool = all {
    freshKey(answered, id),
    log' = log.concat(b),
    answered' = answered.union(Set(id)),
  }

  // a call the API refused (403: the block's policy refused the caller) ran
  // nothing and answers nothing: its key stays unanswered
  action denied: bool = all { log' = log, answered' = answered }

  action request(payout: str, account: str, amount: int, id: str, caller: str, result: str): bool = {
    val args_: RequestArgs = { payout: payout, account: account, amount: amount, caller: caller }
    if (result == "denied") denied
    else if (result == "conflict") answers([], id)
    else all {
      result == requestOutcome(log, args_),
      answers(if (result == "ok") caused(requestEvents(log, args_), ("command", id)) else [], id),
    }
  }

  action step = {
    any {
      {
        nondet payout = STRS.oneOf()
        nondet account = STRS.oneOf()
        nondet amount = INTS.oneOf()
        nondet caller = STRS.oneOf()
        nondet id = nextID(answered).oneOf()
        request(payout, account, amount, id, caller, requestOutcome(log, { payout: payout, account: account, amount: amount, caller: caller }))
      },
      all { log' = log, answered' = answered },
    }
  }
}
